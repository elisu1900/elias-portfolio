---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const projects = (await getCollection('projects')).filter((p) => !p.data.draft);
---
<Base title="projects">
  <section class="wrap" style="padding:4rem 1.25rem">
    <h1>projects</h1>
    <ul>
      {projects.map((p) => (
        <li><a href={`/projects/${p.id}`}>{p.data.title}</a> — {p.data.summary}</li>
      ))}
    </ul>
  </section>
</Base>
