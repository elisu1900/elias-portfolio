---
import Base from '../../layouts/Base.astro';
import AboutBody from '../../components/sections/AboutBody.astro';
import ContactCta from '../../components/sections/ContactCta.astro';
import { getLocale, useT } from '../../i18n/utils';

const locale = getLocale(Astro.url);
const t = useT(locale);
---

<Base title={t('about.title')} description={t('about.lead')}>
  <AboutBody locale={locale} />
  <ContactCta locale={locale} />
</Base>
