---
import Base from '../layouts/Base.astro';
import NotFoundBody from '../components/sections/NotFoundBody.astro';
import { getLocale, useT } from '../i18n/utils';

const locale = getLocale(Astro.url);
const t = useT(locale);
---

<Base title={t('404.title')} description={t('404.body')} field="hero">
  <NotFoundBody locale={locale} />
</Base>
