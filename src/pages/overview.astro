---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Skills from '../components/sections/Skills.astro';
import FlagshipTeaser from '../components/sections/FlagshipTeaser.astro';
import ContactCta from '../components/sections/ContactCta.astro';
import { getLocale, useT } from '../i18n/utils';

const locale = getLocale(Astro.url);
const t = useT(locale);
---

<Base title={t('hero.role')} description={t('hero.pitch')} field="hero">
  <Hero locale={locale} />
  <Skills locale={locale} />
  <FlagshipTeaser locale={locale} />
  <ContactCta locale={locale} />
</Base>
