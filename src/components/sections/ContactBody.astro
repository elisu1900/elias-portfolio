---
import type { Locale } from '../../data/site';
import { site } from '../../data/site';
import { useT } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useT(locale);

/**
 * The address is never written into the HTML. Two halves travel separately and
 * the script joins them with an "@" at runtime, so the built markup holds no
 * literal address and no literal mailto: target for scrapers to harvest.
 */
const [emailUser, emailDomain] = site.email.split('@');
const subject = t('contact.emailSubject');
---

<section class="section contact" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="head">
      <h1 id="contact-title">{t('contact.title')}</h1>
      <p class="lead intro">{t('contact.lead')}</p>
    </div>

    <div class="split">
      <div class="maincol">
        <div class="nd mailnode" data-reveal>
          <div class="nd__head">
            <span class="node__port" aria-hidden="true"></span>
            <span class="nd__state" aria-hidden="true"><span class="pip"></span></span>
          </div>

          <div class="mailnode__body">
            {/*
              Without JavaScript this link is an in-page jump to the GitHub and
              LinkedIn panel, so it always goes somewhere real. The script below
              swaps the href for the assembled mailto: target.
            */}
            <a
              id="email-link"
              class="btn btn--primary mailbtn"
              href="#elsewhere-title"
              data-user={emailUser}
              data-domain={emailDomain}
              data-subject={subject}
            >
              <svg
                class="mailbtn__icon"
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="2.5" y="4.5" width="19" height="15" rx="2"></rect>
                <path d="M3 7l9 6 9-6"></path>
              </svg>
              <span class="mailbtn__label">{t('contact.emailMe')}</span>
              <span class="mailbtn__arrow" aria-hidden="true">→</span>
            </a>

            <p class="hint mono" id="email-hint" hidden>{t('contact.emailMeHint')}</p>

            <noscript>
              <p class="hint mono">
                <a href="#elsewhere-title">{t('contact.elsewhere')} ↓</a>
              </p>
            </noscript>

            <div class="alt">
              <span class="alt__label mono">{t('contact.orEmail')}</span>
              <button
                id="email-reveal"
                class="btn btn--ghost reveal"
                type="button"
                data-user={emailUser}
                data-domain={emailDomain}
              >
                {t('contact.emailReveal')}
              </button>
              <p class="email-out mono" id="email-out" aria-live="polite"></p>
            </div>
          </div>

          <span class="xh xh--tl" aria-hidden="true"></span>
          <span class="xh xh--br" aria-hidden="true"></span>
        </div>
      </div>

      <aside class="aside">
        <section class="nd panel" aria-labelledby="elsewhere-title" data-reveal>
          <div class="nd__head">
            <span class="node__port" aria-hidden="true"></span>
            <h2 id="elsewhere-title">{t('contact.elsewhere')}</h2>
          </div>
          <ul class="links">
            <li>
              <a href={site.socials.github} target="_blank" rel="me noopener noreferrer">
                <span>GitHub</span> <span class="out" aria-hidden="true">↗</span>
              </a>
            </li>
            <li>
              <a href={site.socials.linkedin} target="_blank" rel="me noopener noreferrer">
                <span>LinkedIn</span> <span class="out" aria-hidden="true">↗</span>
              </a>
            </li>
          </ul>
        </section>
      </aside>
    </div>
  </div>
</section>

<script>
  const joinAddress = (user?: string, domain?: string) =>
    [user, domain].join(String.fromCharCode(64));
  const MAILTO = String.fromCharCode(109, 97, 105, 108, 116, 111, 58);

  const link = document.getElementById('email-link') as HTMLAnchorElement | null;
  const hint = document.getElementById('email-hint');

  if (link) {
    // The hint only tells the truth once the script is running.
    hint?.removeAttribute('hidden');

    // Build the target lazily: on the first hint of interaction, and again at
    // click time so a real click always navigates to the assembled mailto:.
    const arm = () => {
      const address = joinAddress(link.dataset.user, link.dataset.domain);
      const subject = link.dataset.subject ?? '';
      link.href = `${MAILTO}${address}?subject=${encodeURIComponent(subject)}`;
    };

    link.addEventListener('pointerenter', arm);
    link.addEventListener('touchstart', arm, { passive: true });
    link.addEventListener('focus', arm);
    link.addEventListener('click', arm);
    link.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') arm();
    });
  }

  const reveal = document.getElementById('email-reveal') as HTMLButtonElement | null;
  const out = document.getElementById('email-out');

  reveal?.addEventListener('click', () => {
    if (!out) return;
    const address = joinAddress(reveal.dataset.user, reveal.dataset.domain);
    const anchor = document.createElement('a');
    anchor.href = MAILTO + address;
    anchor.textContent = address;
    out.replaceChildren(anchor);
    reveal.hidden = true;
    anchor.focus();
  });
</script>

<style>
  .head { max-width: 58ch; }
  h1 {
    font-size: clamp(2.1rem, 7.5vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.03em;
    margin: 0 0 0.9rem;
  }
  .intro { margin: 0 0 clamp(2rem, 6vw, 3rem); }

  .split {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }
  @media (min-width: 900px) {
    .split {
      grid-template-columns: minmax(0, 1fr) minmax(240px, 300px);
      align-items: start;
    }
  }
  .maincol,
  .aside { min-width: 0; }

  /* ── node chrome ───────────────────────────────────────────── */
  .nd {
    position: relative;
    border: 1px solid var(--line-dim);
    border-radius: var(--radius);
    background:
      radial-gradient(120% 150% at 0% 0%, rgba(45, 212, 191, 0.07), transparent 58%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0) 28%),
      var(--bg-card);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.045),
      0 26px 56px -36px rgba(0, 0, 0, 0.95);
  }
  .nd__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--line-dim);
    border-radius: var(--radius) var(--radius) 0 0;
    background: linear-gradient(180deg, rgba(45, 212, 191, 0.07), transparent), var(--bg-sunken);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .nd__state { margin-left: auto; display: inline-flex; align-items: center; }
  .nd__state .pip {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--mx);
    box-shadow: 0 0 0 3px rgba(45, 212, 191, 0.16);
  }
  @media (prefers-reduced-motion: no-preference) {
    .nd__state .pip { animation: pulse 2.6s ease-in-out infinite; }
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 3px rgba(45, 212, 191, 0.16); }
    50% { box-shadow: 0 0 0 6px rgba(45, 212, 191, 0.05); }
  }
  .nd__head h2 {
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mx-soft);
  }

  .xh {
    position: absolute;
    width: 10px;
    height: 10px;
    border: 1px solid var(--mx);
    opacity: 0.4;
    pointer-events: none;
  }
  .xh--tl { top: -1px; left: -1px; border-right: 0; border-bottom: 0; }
  .xh--br { right: -1px; bottom: -1px; border-left: 0; border-top: 0; }

  /* ── the one control ───────────────────────────────────────── */
  .mailnode__body { padding: clamp(1.25rem, 4vw, 2.25rem); }

  .mailbtn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    width: 100%;
    padding: clamp(0.95rem, 3vw, 1.25rem) clamp(1rem, 4vw, 1.75rem);
    font-size: clamp(0.95rem, 2.6vw, 1.1rem);
    letter-spacing: 0.01em;
    border-radius: 6px;
    box-shadow: 0 18px 40px -26px rgba(45, 212, 191, 0.75);
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }
  .mailbtn__label { overflow-wrap: anywhere; }
  .mailbtn__icon { flex: none; }
  .mailbtn__arrow {
    flex: none;
    transition: transform 0.2s ease;
  }
  .mailbtn:hover,
  .mailbtn:focus-visible {
    box-shadow: 0 22px 46px -24px rgba(45, 212, 191, 0.9);
  }
  @media (prefers-reduced-motion: no-preference) {
    .mailbtn:hover { transform: translateY(-2px); }
    .mailbtn:hover .mailbtn__arrow { transform: translateX(4px); }
  }

  .hint {
    margin: 0.9rem 0 0;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .alt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.9rem;
    margin-top: clamp(1.25rem, 4vw, 1.75rem);
    padding-top: clamp(1.1rem, 3vw, 1.4rem);
    border-top: 1px solid var(--line-dim);
  }
  .alt__label {
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .reveal { font-size: 0.82rem; }
  .email-out {
    flex: 1 1 100%;
    margin: 0;
    font-size: 0.85rem;
    overflow-wrap: anywhere;
  }

  /* ── aside ─────────────────────────────────────────────────── */
  .aside {
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.5rem);
    align-content: start;
  }
  .links {
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }
  .links li + li { border-top: 1px solid rgba(127, 138, 163, 0.1); }
  .links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    transition: background 0.2s ease;
  }
  .links a:hover { background: rgba(45, 212, 191, 0.05); }
  .out { color: var(--mx); }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      [data-reveal] {
        animation: rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 40%;
      }
    }
  }
  @keyframes rise {
    from { opacity: 0.35; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
