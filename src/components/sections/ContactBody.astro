---
import type { Locale } from '../../data/site';
import { site } from '../../data/site';
import { useT } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useT(locale);

const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '';
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY ?? '';
const configured = Boolean(web3formsKey) && Boolean(turnstileKey);

/**
 * The address is never written into the HTML. Two halves travel separately and
 * the reveal button joins them with an "@" at runtime.
 */
const [emailUser, emailDomain] = site.email.split('@');

const types = [
  { value: 'app', key: 'contact.type.app' },
  { value: 'site', key: 'contact.type.site' },
  { value: 'automation', key: 'contact.type.automation' },
  { value: 'other', key: 'contact.type.other' },
] as const;

const subject = `Portfolio enquiry — ${site.fullName}`;

/** Shown in the node header: where the form actually posts. */
const endpointHost = 'api.web3forms.com';
---

<section class="section contact" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="head">
      <h1 id="contact-title">{t('contact.title')}</h1>
      <p class="lead intro">{t('contact.lead')}</p>
    </div>

    <div class="split">
      <div class="formcol">
        {
          !configured && (
            <p class="notice mono" role="note">
              {t('contact.notConfigured')}
            </p>
          )
        }

        <div class="nd" data-reveal>
          <div class="nd__head">
            <span class="node__port" aria-hidden="true"></span>
            <span class="nd__verb">POST</span>
            <span class="nd__sep" aria-hidden="true">/</span>
            <span class="nd__host">{endpointHost}</span>
            <span class={`nd__state${configured ? '' : ' nd__state--off'}`} aria-hidden="true">
              <span class="pip"></span>
            </span>
          </div>

          <form
            id="contact-form"
            class="form"
            novalidate
            data-key={web3formsKey}
            data-configured={configured ? 'true' : 'false'}
            data-sending={t('contact.sending')}
            data-success={t('contact.success')}
            data-error={t('contact.error')}
            data-send={t('contact.send')}
            data-subject={subject}
          >
            <div class="field">
              <label class="mono" for="cf-name">
                <span class="idx" aria-hidden="true">01</span>
                {t('contact.name')}
                <span class="req" title={t('contact.required')} aria-hidden="true">*</span>
              </label>
              <input
                id="cf-name"
                name="name"
                type="text"
                autocomplete="name"
                required
                maxlength="120"
              />
            </div>

            <div class="field">
              <label class="mono" for="cf-email">
                <span class="idx" aria-hidden="true">02</span>
                {t('contact.email')}
                <span class="req" title={t('contact.required')} aria-hidden="true">*</span>
              </label>
              <input
                id="cf-email"
                name="email"
                type="email"
                autocomplete="email"
                required
                maxlength="160"
              />
            </div>

            <div class="field">
              <label class="mono" for="cf-type">
                <span class="idx" aria-hidden="true">03</span>
                {t('contact.type')}
              </label>
              <select id="cf-type" name="project_type">
                {types.map((o) => <option value={o.value}>{t(o.key)}</option>)}
              </select>
            </div>

            <div class="field">
              <label class="mono" for="cf-message">
                <span class="idx" aria-hidden="true">04</span>
                {t('contact.message')}
                <span class="req" title={t('contact.required')} aria-hidden="true">*</span>
              </label>
              <textarea
                id="cf-message"
                name="message"
                rows="6"
                required
                maxlength="4000"
                placeholder={t('contact.messagePlaceholder')}></textarea>
            </div>

            {/* Honeypot: people never see it, bots fill it in. */}
            <div class="honeypot" aria-hidden="true">
              <label for="cf-botcheck">Leave this field empty</label>
              <input
                id="cf-botcheck"
                type="text"
                name="botcheck"
                tabindex="-1"
                autocomplete="off"
              />
            </div>

            {
              turnstileKey && (
                <div
                  class="cf-turnstile turnstile"
                  data-sitekey={turnstileKey}
                  data-theme="dark"
                  data-language={locale}
                />
              )
            }

            <div class="actions">
              <button class="btn btn--primary submit" type="submit" disabled={!configured}>
                {t('contact.send')}
              </button>
              <p class="formstatus mono" role="status" aria-live="polite" data-state="idle"></p>
            </div>
          </form>

          <span class="xh xh--tl" aria-hidden="true"></span>
          <span class="xh xh--br" aria-hidden="true"></span>
        </div>
      </div>

      <aside class="aside">
        <section class="nd panel" aria-labelledby="email-title" data-reveal>
          <div class="nd__head">
            <span class="node__port" aria-hidden="true"></span>
            <h2 id="email-title">{t('contact.orEmail')}</h2>
          </div>
          <div class="panel__body">
            <button
              id="email-reveal"
              class="btn btn--ghost reveal"
              type="button"
              data-user={emailUser}
              data-domain={emailDomain}
            >
              {t('contact.emailReveal')}
            </button>
            <p class="email-out mono" id="email-out" aria-live="polite"></p>
          </div>
        </section>

        <section class="nd panel" aria-labelledby="elsewhere-title" data-reveal>
          <div class="nd__head">
            <span class="node__port" aria-hidden="true"></span>
            <h2 id="elsewhere-title">{t('contact.elsewhere')}</h2>
          </div>
          <ul class="links">
            <li>
              <a href={site.socials.github} target="_blank" rel="me noopener noreferrer">
                <span>GitHub</span> <span class="out" aria-hidden="true">↗</span>
              </a>
            </li>
            <li>
              <a href={site.socials.linkedin} target="_blank" rel="me noopener noreferrer">
                <span>LinkedIn</span> <span class="out" aria-hidden="true">↗</span>
              </a>
            </li>
          </ul>
        </section>
      </aside>
    </div>
  </div>
</section>

{
  turnstileKey && (
    <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js" />
  )
}

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  if (form) {
    const status = form.querySelector('.formstatus') as HTMLParagraphElement;
    const submit = form.querySelector('.submit') as HTMLButtonElement;
    const configured = form.dataset.configured === 'true';

    const setStatus = (text: string, state: string) => {
      status.textContent = text;
      status.dataset.state = state;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!configured || submit.disabled) return;

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      submit.disabled = true;
      submit.textContent = form.dataset.sending ?? '';
      setStatus(form.dataset.sending ?? '', 'sending');

      const data = new FormData(form);
      data.append('access_key', form.dataset.key ?? '');
      data.append('subject', form.dataset.subject ?? '');
      data.append('from_name', String(data.get('name') ?? ''));

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(data.entries())),
        });
        const result = await response.json();

        if (response.ok && result.success) {
          form.reset();
          setStatus(form.dataset.success ?? '', 'success');
        } else {
          setStatus(form.dataset.error ?? '', 'error');
        }
      } catch {
        setStatus(form.dataset.error ?? '', 'error');
      } finally {
        submit.textContent = form.dataset.send ?? '';
        submit.disabled = false;
        // A Turnstile token is single-use, so reset the widget for the next attempt.
        const turnstile = (window as unknown as { turnstile?: { reset?: () => void } }).turnstile;
        turnstile?.reset?.();
      }
    });
  }

  const reveal = document.getElementById('email-reveal') as HTMLButtonElement | null;
  const out = document.getElementById('email-out');

  reveal?.addEventListener('click', () => {
    if (!out) return;
    const address = [reveal.dataset.user, reveal.dataset.domain].join(String.fromCharCode(64));
    const link = document.createElement('a');
    link.href = String.fromCharCode(109, 97, 105, 108, 116, 111, 58) + address;
    link.textContent = address;
    out.replaceChildren(link);
    reveal.hidden = true;
    link.focus();
  });
</script>

<style>
  .head { max-width: 58ch; }
  h1 {
    font-size: clamp(2.1rem, 7.5vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.03em;
    margin: 0 0 0.9rem;
  }
  .intro { margin: 0 0 clamp(2rem, 6vw, 3rem); }

  .split {
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
  }
  @media (min-width: 900px) {
    .split {
      grid-template-columns: minmax(0, 1fr) minmax(240px, 300px);
      align-items: start;
    }
  }
  .formcol,
  .aside { min-width: 0; }

  /* ── node chrome ───────────────────────────────────────────── */
  .nd {
    position: relative;
    border: 1px solid var(--line-dim);
    border-radius: var(--radius);
    background:
      radial-gradient(120% 150% at 0% 0%, rgba(45, 212, 191, 0.07), transparent 58%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0) 28%),
      var(--bg-card);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.045),
      0 26px 56px -36px rgba(0, 0, 0, 0.95);
  }
  .nd__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--line-dim);
    border-radius: var(--radius) var(--radius) 0 0;
    background: linear-gradient(180deg, rgba(45, 212, 191, 0.07), transparent), var(--bg-sunken);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .nd__verb { color: var(--mx-soft); }
  .nd__sep { color: var(--line-hi); }
  .nd__host { text-transform: none; letter-spacing: 0.05em; }
  .nd__state { margin-left: auto; display: inline-flex; align-items: center; }
  .nd__state .pip {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--mx);
    box-shadow: 0 0 0 3px rgba(45, 212, 191, 0.16);
  }
  .nd__state--off .pip {
    background: var(--amber);
    box-shadow: 0 0 0 3px rgba(251, 191, 36, 0.16);
  }
  .nd__head h2 {
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mx-soft);
  }

  .xh {
    position: absolute;
    width: 10px;
    height: 10px;
    border: 1px solid var(--mx);
    opacity: 0.4;
    pointer-events: none;
  }
  .xh--tl { top: -1px; left: -1px; border-right: 0; border-bottom: 0; }
  .xh--br { right: -1px; bottom: -1px; border-left: 0; border-top: 0; }

  /* ── unconfigured notice ───────────────────────────────────── */
  .notice {
    margin: 0 0 1.25rem;
    padding: 0.9rem 1rem;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--amber);
    border: 1px solid rgba(251, 191, 36, 0.45);
    border-left-width: 3px;
    border-left-color: var(--amber);
    border-radius: var(--radius);
    background: rgba(251, 191, 36, 0.07);
  }

  /* ── form ──────────────────────────────────────────────────── */
  .form {
    display: grid;
    gap: 1.1rem;
    padding: clamp(1.1rem, 3.5vw, 1.75rem);
  }
  .field { display: grid; gap: 0.4rem; }
  label {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .idx { color: var(--mx-deep); }
  .req { color: var(--mx); }
  input,
  select,
  textarea {
    width: 100%;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    color: var(--text-hi);
    background: var(--bg-sunken);
    border: 1px solid var(--line-dim);
    border-left: 2px solid var(--line-dim);
    border-radius: 4px;
    padding: 0.7rem 0.85rem;
    box-shadow: inset 0 1px 6px rgba(0, 0, 0, 0.5);
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  textarea { resize: vertical; min-height: 9rem; }
  input:hover,
  select:hover,
  textarea:hover { border-color: var(--line); }
  input:focus,
  select:focus,
  textarea:focus { border-left-color: var(--mx); }
  input::placeholder,
  textarea::placeholder { color: var(--muted); }
  select {
    appearance: none;
    background-image:
      linear-gradient(45deg, transparent 50%, var(--mx) 50%),
      linear-gradient(135deg, var(--mx) 50%, transparent 50%);
    background-position: calc(100% - 18px) 55%, calc(100% - 13px) 55%;
    background-size: 5px 5px, 5px 5px;
    background-repeat: no-repeat;
    padding-right: 2.25rem;
  }

  .honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .turnstile { min-height: 65px; }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-top: 0.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line-dim);
  }
  .submit:disabled { opacity: 0.45; cursor: not-allowed; }

  .formstatus {
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    min-height: 1.4em;
    color: var(--muted);
  }
  .formstatus[data-state='sending'] { color: var(--violet); }
  .formstatus[data-state='success'] { color: var(--mx); }
  .formstatus[data-state='error'] { color: var(--danger); }

  /* ── aside ─────────────────────────────────────────────────── */
  .aside {
    display: grid;
    gap: clamp(1rem, 2.5vw, 1.5rem);
    align-content: start;
  }
  .panel__body { padding: 1rem; }
  .reveal { font-size: 0.82rem; }
  .email-out {
    margin: 0.75rem 0 0;
    font-size: 0.82rem;
    overflow-wrap: anywhere;
  }
  .links {
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }
  .links li + li { border-top: 1px solid rgba(127, 138, 163, 0.1); }
  .links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    transition: background 0.2s ease;
  }
  .links a:hover { background: rgba(45, 212, 191, 0.05); }
  .out { color: var(--mx); }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      [data-reveal] {
        animation: rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 40%;
      }
    }
  }
  @keyframes rise {
    from { opacity: 0.35; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
