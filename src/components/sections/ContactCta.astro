---
import type { Locale } from '../../data/site';
import { useT, localize } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useT(locale);
---

<section class="band gridbg" aria-labelledby="cta-title">
  <div class="wrap">
    <div class="feed" aria-hidden="true"></div>

    <div class="nd inner" data-reveal>
      <div class="copy">
        <p class="eyebrow tag">{t('contact.title')}</p>
        <h2 id="cta-title">{t('contact.lead')}</h2>
      </div>
      <a class="btn btn--primary" href={localize('/contact', locale)}>{t('hero.ctaHire')}</a>

      <span class="node__port port--in" aria-hidden="true"></span>
      <span class="xh xh--tl" aria-hidden="true"></span>
      <span class="xh xh--br" aria-hidden="true"></span>
    </div>
  </div>
</section>

<style>
  .band {
    position: relative;
    border-top: 1px solid var(--line-dim);
    background-color: var(--bg-sunken);
    box-shadow: inset 0 40px 80px -60px #000;
    padding-block: clamp(2.25rem, 6vw, 3.75rem);
  }
  .feed {
    position: absolute;
    top: 0;
    left: clamp(1.25rem, 7%, 3.5rem);
    width: 1px;
    height: clamp(1.5rem, 4vw, 2.25rem);
    background: linear-gradient(to bottom, var(--mx), transparent);
  }

  .nd {
    position: relative;
    display: grid;
    gap: 1.5rem;
    align-items: center;
    padding: clamp(1.25rem, 3.5vw, 2rem);
    border: 1px solid var(--line-dim);
    border-radius: var(--radius);
    background:
      radial-gradient(120% 150% at 0% 0%, rgba(45, 212, 191, 0.08), transparent 60%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0) 34%),
      var(--bg-card);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.045),
      0 24px 54px -34px rgba(0, 0, 0, 0.95);
  }
  @media (min-width: 760px) {
    .nd {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 2rem;
    }
  }
  .copy { min-width: 0; }
  .tag { margin: 0 0 0.6rem; font-size: 0.66rem; }
  h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(1.2rem, 3.2vw, 1.75rem);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--text-hi);
    max-width: 44ch;
  }
  .btn { justify-self: start; }

  .port--in {
    position: absolute;
    top: 1.35rem;
    left: -5px;
    display: block;
    background: var(--mx);
    box-shadow: 0 0 0 3px rgba(45, 212, 191, 0.16);
  }
  .xh {
    position: absolute;
    width: 10px;
    height: 10px;
    border: 1px solid var(--mx);
    opacity: 0.4;
    pointer-events: none;
  }
  .xh--tl { top: -1px; left: -1px; border-right: 0; border-bottom: 0; }
  .xh--br { right: -1px; bottom: -1px; border-left: 0; border-top: 0; }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      [data-reveal] {
        animation: rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 45%;
      }
    }
  }
  @keyframes rise {
    from { opacity: 0.3; transform: translateY(14px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
