---
import type { Locale } from '../../data/site';
import { useT, localize } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useT(locale);
---

<section class="section nf" aria-labelledby="nf-title">
  <div class="wrap">
    <div class="canvas gridbg">
      <div class="slot" aria-hidden="true">
        <span class="edge"></span>
        <span class="term"></span>
        <div class="ghost">
          <span class="code mono">404</span>
          <span class="xh xh--tl"></span>
          <span class="xh xh--tr"></span>
          <span class="xh xh--bl"></span>
          <span class="xh xh--br"></span>
        </div>
      </div>

      <div class="copy">
        <h1 id="nf-title">{t('404.title')}</h1>
        <p class="lead body">{t('404.body')}</p>
        <a class="btn btn--primary" href={localize('/', locale)}>
          {t('404.cta')} <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .nf { display: grid; align-items: center; min-height: 58vh; }

  .canvas {
    position: relative;
    display: grid;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: center;
    padding: clamp(1.5rem, 5vw, 3rem);
    border: 1px solid var(--line-dim);
    border-radius: var(--radius);
    background-color: var(--bg-sunken);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.03),
      inset 0 50px 90px -60px #000,
      0 26px 60px -36px rgba(0, 0, 0, 0.9);
  }
  @media (min-width: 820px) {
    .canvas {
      grid-template-columns: minmax(0, 240px) minmax(0, 1fr);
      gap: 3rem;
    }
  }

  /* ── the missing node ──────────────────────────────────────── */
  .slot {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 150px;
  }
  .edge {
    flex: none;
    width: clamp(1.5rem, 6vw, 3rem);
    height: 1px;
    background: repeating-linear-gradient(to right, var(--line-hi) 0 4px, transparent 4px 8px);
  }
  .term {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--bg-sunken);
    border: 1px solid var(--amber);
    margin-right: 0.6rem;
  }
  .ghost {
    position: relative;
    flex: 1;
    min-width: 0;
    display: grid;
    place-items: center;
    aspect-ratio: 5 / 4;
    max-height: 170px;
    border: 1px dashed rgba(251, 191, 36, 0.4);
    border-radius: var(--radius);
    background:
      repeating-linear-gradient(
        135deg,
        rgba(251, 191, 36, 0.045) 0 6px,
        transparent 6px 14px
      );
  }
  .code {
    font-size: clamp(2.25rem, 9vw, 3.5rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--amber);
    opacity: 0.4;
  }
  .xh {
    position: absolute;
    width: 9px;
    height: 9px;
    border: 1px solid var(--amber);
    opacity: 0.55;
  }
  .xh--tl { top: -1px; left: -1px; border-right: 0; border-bottom: 0; }
  .xh--tr { top: -1px; right: -1px; border-left: 0; border-bottom: 0; }
  .xh--bl { bottom: -1px; left: -1px; border-right: 0; border-top: 0; }
  .xh--br { bottom: -1px; right: -1px; border-left: 0; border-top: 0; }

  @media (prefers-reduced-motion: no-preference) {
    .term { animation: pulse 2.4s ease-in-out infinite; }
  }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 1px rgba(251, 191, 36, 0.1); }
    50% { box-shadow: 0 0 0 5px rgba(251, 191, 36, 0.18); }
  }

  /* ── copy ──────────────────────────────────────────────────── */
  .copy { min-width: 0; }
  h1 {
    margin: 0 0 0.9rem;
    font-size: clamp(1.7rem, 6vw, 2.9rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .body { margin: 0 0 1.75rem; }
</style>
