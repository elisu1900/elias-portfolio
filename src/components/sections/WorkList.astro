---
import { getCollection } from 'astro:content';
import type { Locale } from '../../data/site';
import { useT, localize } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useT(locale);

const entries = (await getCollection('work', (e) => e.data.locale === locale)).sort(
  (a, b) => a.data.order - b.data.order || b.data.year - a.data.year
);

const total = String(entries.length).padStart(2, '0');
---

<section class="section work" aria-labelledby="work-title">
  <div class="wrap">
    <div class="head">
      <h1 id="work-title">{t('work.title')}</h1>
      <p class="lead muted sub">{t('work.subtitle')}</p>
    </div>

    <div class="bus" aria-hidden="true">
      <span class="bus__line"></span>
      <span class="bus__tag mono">[{total}]</span>
    </div>

    {
      entries.length === 0 ? (
        <p class="empty mono">{t('work.empty')}</p>
      ) : (
        <ul class="list">
          {entries.map((entry, i) => {
            const slug = entry.id.split('/').pop();
            const href = localize(`/work/${slug}`, locale);
            return (
              <li>
                <article class="nd run" data-reveal>
                  <span class="stub" aria-hidden="true" />
                  <header class="nd__head">
                    <span class="node__port" aria-hidden="true" />
                    <span class="nd__idx">{String(i + 1).padStart(2, '0')}</span>
                    <span class="nd__sep" aria-hidden="true">
                      /
                    </span>
                    <span class="nd__id">{slug}</span>
                    <span class="nd__yr">{entry.data.year}</span>
                  </header>

                  <div class="run__body">
                    <h2>
                      <a href={href}>{entry.data.title}</a>
                    </h2>
                    <p class="summary">{entry.data.summary}</p>

                    <dl class="meta">
                      <div class="meta__row">
                        <dt class="mono">{t('work.role')}</dt>
                        <dd>{entry.data.role}</dd>
                      </div>
                      <div class="meta__row">
                        <dt class="mono">{t('work.stack')}</dt>
                        <dd class="mono dd--mono">{entry.data.stack.slice(0, 5).join(' · ')}</dd>
                      </div>
                    </dl>
                  </div>

                  <footer class="nd__foot">
                    <span class="status status--done">{t('status.inProduction')}</span>
                    <a class="more mono" href={href}>
                      {t('flagship.cta')} <span aria-hidden="true">→</span>
                    </a>
                  </footer>

                  <span class="xh xh--br" aria-hidden="true" />
                </article>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
</section>

<style>
  .work { position: relative; }
  .head { max-width: 46ch; }
  h1 {
    font-size: clamp(2.1rem, 7.5vw, 3.6rem);
    margin: 0 0 0.6rem;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .sub { margin: 0; }

  .bus {
    position: relative;
    height: 11px;
    margin: clamp(1.75rem, 4vw, 2.5rem) 0 clamp(1.5rem, 3.5vw, 2rem);
  }
  .bus__line {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--mx), rgba(45, 212, 191, 0.08) 70%, transparent),
      repeating-linear-gradient(to right, var(--line-dim) 0 1px, transparent 1px 14px);
    background-size: 100% 1px, 100% 11px;
    background-position: 0 5px, 0 0;
    background-repeat: no-repeat;
  }
  .bus__tag {
    position: absolute;
    right: 0;
    top: -0.35rem;
    padding-left: 0.6rem;
    background: var(--bg);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    color: var(--mx-deep);
  }

  .empty {
    color: var(--muted);
    border-left: 2px solid var(--line-hi);
    padding-left: 1rem;
    margin: 0;
  }

  .list {
    display: grid;
    gap: clamp(1.1rem, 2.6vw, 1.6rem);
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nd {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--line-dim);
    border-radius: var(--radius);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0) 30%),
      var(--bg-card);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.045),
      0 22px 50px -34px rgba(0, 0, 0, 0.95);
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }
  .nd:hover {
    border-color: var(--line-hi);
    transform: translateY(-2px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 0 0 1px rgba(45, 212, 191, 0.16),
      0 28px 54px -32px rgba(0, 0, 0, 0.95);
  }
  .stub {
    position: absolute;
    left: 1.15rem;
    top: calc(-1 * clamp(1.5rem, 3.5vw, 2rem) - 1px);
    width: 1px;
    height: clamp(1.5rem, 3.5vw, 2rem);
    background: linear-gradient(to bottom, var(--line-dim), var(--line-hi));
    transition: background 0.25s ease;
  }
  .nd:hover .stub { background: linear-gradient(to bottom, var(--mx-deep), var(--mx)); }

  .nd__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.85rem;
    border-bottom: 1px solid var(--line-dim);
    border-radius: var(--radius) var(--radius) 0 0;
    background: linear-gradient(180deg, rgba(45, 212, 191, 0.055), transparent), var(--bg-sunken);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .nd__idx { color: var(--mx-deep); }
  .nd__sep { color: var(--line-hi); }
  .nd__id { color: var(--mx-soft); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .nd__yr { margin-left: auto; color: var(--muted); }
  .nd__head .node__port { transition: background 0.25s ease, box-shadow 0.25s ease; }
  .nd:hover .node__port {
    background: var(--mx);
    box-shadow: 0 0 0 3px rgba(45, 212, 191, 0.2);
  }

  .run__body { padding: 1.25rem 1.1rem 1.4rem; }
  .run h2 {
    margin: 0 0 0.6rem;
    font-size: clamp(1.1rem, 2.6vw, 1.3rem);
    line-height: 1.25;
    letter-spacing: -0.015em;
  }
  .run h2 a { color: var(--text-hi); }
  .run h2 a:hover { color: var(--mx); }
  .summary {
    margin: 0 0 1.1rem;
    font-size: 0.93rem;
  }

  .meta {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding: 0.85rem 0.9rem;
    border: 1px solid var(--line-dim);
    border-radius: 4px;
    background: var(--bg-sunken);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.02);
  }
  .meta__row {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }
  .meta dt {
    margin: 0;
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mx-deep);
  }
  .meta dd {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-hi);
    overflow-wrap: break-word;
  }
  .dd--mono {
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--text);
  }

  .nd__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-top: auto;
    padding: 0.6rem 1.1rem;
    border-top: 1px solid var(--line-dim);
    background: rgba(6, 7, 9, 0.45);
  }
  .status { font-size: 0.62rem; }
  .more {
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .more span { transition: transform 0.2s ease; display: inline-block; }
  .nd:hover .more span { transform: translateX(3px); }

  .xh {
    position: absolute;
    width: 9px;
    height: 9px;
    border: 1px solid var(--mx);
    opacity: 0.35;
    pointer-events: none;
  }
  .xh--br { right: -1px; bottom: -1px; border-left: 0; border-top: 0; }

  @media (prefers-reduced-motion: reduce) {
    .nd:hover { transform: none; }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      [data-reveal] {
        animation: rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 45%;
      }
    }
  }
  @keyframes rise {
    from { opacity: 0.25; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
