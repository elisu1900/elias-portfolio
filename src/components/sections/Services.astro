---
import type { Locale } from '../../data/site';
import { useT } from '../../i18n/utils';
import type { UIKey } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useT(locale);

const services: { title: UIKey; body: UIKey }[] = [
  { title: 'services.apps.title', body: 'services.apps.body' },
  { title: 'services.sites.title', body: 'services.sites.body' },
  { title: 'services.automation.title', body: 'services.automation.body' },
];

/** Node slug taken from the dictionary key: services.apps.title -> apps. */
const slugOf = (key: UIKey) => key.split('.')[1];
---

<section class="section svcs" aria-labelledby="services-title">
  <div class="wrap">
    <div class="feed" aria-hidden="true"></div>
    <div class="head">
      <h2 id="services-title">{t('services.title')}</h2>
      <p class="lead muted sub">{t('services.subtitle')}</p>
    </div>

    <div class="bus" aria-hidden="true">
      <span class="bus__line"></span>
      <span class="bus__tag mono">{services.length} × node</span>
    </div>

    <div class="nodes">
      {
        services.map((s, i) => (
          <article class="nd svc" data-reveal>
            <span class="stub" aria-hidden="true"></span>
            <header class="nd__head">
              <span class="node__port" aria-hidden="true"></span>
              <span class="nd__idx">{String(i + 1).padStart(2, '0')}</span>
              <span class="nd__sep" aria-hidden="true">/</span>
              <span class="nd__id">{slugOf(s.title)}</span>
            </header>
            <div class="svc__body">
              <span class="wm mono" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{t(s.title)}</h3>
              <p class="body">{t(s.body)}</p>
            </div>
            <span class="xh xh--br" aria-hidden="true"></span>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .svcs {
    position: relative;
    padding-top: clamp(2rem, 5vw, 3rem);
  }
  /* incoming edge, aligned with the rail the section above hands over */
  .feed {
    width: 1px;
    height: clamp(1.5rem, 4vw, 2.25rem);
    margin: 0 0 clamp(1rem, 2.5vw, 1.5rem) clamp(1.25rem, 7%, 3.5rem);
    background: linear-gradient(to bottom, transparent, var(--line-hi));
  }
  .head { max-width: 46ch; }
  h2 {
    font-size: clamp(1.6rem, 4.4vw, 2.3rem);
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }
  .sub { margin: 0; }

  /* ── bus line the nodes hang off ───────────────────────────── */
  .bus {
    position: relative;
    height: 11px;
    margin: clamp(1.75rem, 4vw, 2.5rem) 0 clamp(1.5rem, 3.5vw, 2rem);
  }
  .bus__line {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--mx), rgba(45, 212, 191, 0.08) 70%, transparent),
      repeating-linear-gradient(to right, var(--line-dim) 0 1px, transparent 1px 14px);
    background-size: 100% 1px, 100% 11px;
    background-position: 0 5px, 0 0;
    background-repeat: no-repeat;
  }
  .bus__tag {
    position: absolute;
    right: 0;
    top: -0.35rem;
    padding-left: 0.6rem;
    background: var(--bg);
    font-size: 0.6rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--mx-deep);
  }

  /* ── nodes ─────────────────────────────────────────────────── */
  .nodes {
    display: grid;
    gap: clamp(1.1rem, 2.6vw, 1.6rem);
    grid-template-columns: repeat(auto-fit, minmax(255px, 1fr));
  }
  .nd {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line-dim);
    border-radius: var(--radius);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0) 32%),
      var(--bg-card);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.045),
      0 20px 46px -32px rgba(0, 0, 0, 0.95);
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  }
  .nd:hover {
    border-color: var(--line-hi);
    transform: translateY(-2px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 0 0 1px rgba(45, 212, 191, 0.16),
      0 26px 50px -30px rgba(0, 0, 0, 0.95);
  }
  /* edge stub rising from the bus into the node's input port */
  .stub {
    position: absolute;
    left: 1.15rem;
    top: calc(-1 * clamp(1.5rem, 3.5vw, 2rem) - 1px);
    width: 1px;
    height: clamp(1.5rem, 3.5vw, 2rem);
    background: linear-gradient(to bottom, var(--line-dim), var(--line-hi));
    transition: background 0.25s ease;
  }
  .nd:hover .stub { background: linear-gradient(to bottom, var(--mx-deep), var(--mx)); }

  .nd__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.85rem;
    border-bottom: 1px solid var(--line-dim);
    border-radius: var(--radius) var(--radius) 0 0;
    background: linear-gradient(180deg, rgba(45, 212, 191, 0.055), transparent), var(--bg-sunken);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .nd__idx { color: var(--mx-deep); }
  .nd__sep { color: var(--line-hi); }
  .nd__id { color: var(--mx-soft); }
  .nd__head .node__port { transition: background 0.25s ease, box-shadow 0.25s ease; }
  .nd:hover .node__port {
    background: var(--mx);
    box-shadow: 0 0 0 3px rgba(45, 212, 191, 0.2);
  }

  .svc__body {
    position: relative;
    padding: 1.3rem 1.25rem 1.5rem;
    overflow: hidden;
  }
  .wm {
    position: absolute;
    right: 0.5rem;
    top: -0.35rem;
    font-size: 4.25rem;
    font-weight: 700;
    line-height: 1;
    color: var(--mx);
    opacity: 0.06;
    letter-spacing: -0.04em;
  }
  .svc h3 {
    position: relative;
    margin: 0 0 0.7rem;
    font-size: 1.02rem;
    line-height: 1.35;
    padding-left: 0.7rem;
    border-left: 2px solid var(--mx);
  }
  .body {
    margin: 0;
    font-size: 0.93rem;
    color: var(--text);
  }

  .xh {
    position: absolute;
    width: 9px;
    height: 9px;
    border: 1px solid var(--mx);
    opacity: 0.35;
    pointer-events: none;
  }
  .xh--br { right: -1px; bottom: -1px; border-left: 0; border-top: 0; }

  /* horizontal edges between the three nodes on wide screens */
  @media (min-width: 900px) {
    .svc:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 1.1rem;
      right: calc(-1 * clamp(1.1rem, 2.6vw, 1.6rem) - 1px);
      width: clamp(1.1rem, 2.6vw, 1.6rem);
      height: 1px;
      background: repeating-linear-gradient(to right, var(--line-hi) 0 3px, transparent 3px 6px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nd:hover { transform: none; }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      [data-reveal] {
        animation: rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 45%;
      }
    }
  }
  @keyframes rise {
    from { opacity: 0.25; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
