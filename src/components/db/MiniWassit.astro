---
/**
 * mini-wassit — the small bot that drifts across the screen and onboards
 * non-technical visitors.
 *
 * It writes the queries; the visitor runs them. It never executes anything on
 * their behalf: copy puts SQL on the clipboard, insert puts it at the prompt,
 * and the visitor presses Enter.
 *
 * Built on <details>/<summary>, so with JavaScript disabled the bot still
 * opens the drawer and every question stays readable and selectable.
 */
import { useT, localize } from '../../i18n/utils';
import type { Locale } from '../../data/site';
import type { UIKey } from '../../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useT(locale);

/** Plain-language label from the dictionary, SQL as a literal. */
const QUERIES: { key: UIKey; sql: string }[] = [
  { key: 'bot.q.who', sql: 'SELECT full_name, role, city, country FROM developer;' },
  { key: 'bot.q.projects', sql: 'SELECT name, client, summary, url FROM projects;' },
  {
    key: 'bot.q.experience',
    sql: 'SELECT co.name AS company, e.position, e.started, e.summary FROM experience e INNER JOIN companies co ON co.id = e.company_id;',
  },
  {
    key: 'bot.q.skills',
    sql: 'SELECT s.name, c.name AS category FROM skills s INNER JOIN skill_categories c ON c.id = s.category_id ORDER BY category;',
  },
  {
    key: 'bot.q.education',
    sql: 'SELECT ed.title, i.name AS institution, ed.ended FROM education ed INNER JOIN institutions i ON i.id = ed.institution_id ORDER BY ed.ended DESC;',
  },
  { key: 'bot.q.contact', sql: 'SELECT channel, handle, preferred FROM contact_channels;' },
  { key: 'bot.q.cv', sql: "SELECT title, format, url FROM documents WHERE kind = 'cv';" },
];
---

<details class="wassit" data-wassit data-reopen={t('bot.reopen')}>
  <summary class="trigger" data-trigger aria-expanded="false">
    <span class="bubble" data-bubble>
      <span class="bubble__ask" data-ask>{t('bot.ask')}</span>
      <span class="bubble__nudge mono" data-nudge>{t('bot.nudge')}</span>
    </span>

    {/* Everything in here is decoration: one character and its effects. */}
    <span class="stage" data-stage aria-hidden="true">
        <span class="rig">
          <span class="hum"></span>
          <span class="packets"><i></i><i></i><i></i></span>

          <span class="kick" data-kick>
            {/* Deliberately the same small silhouette it always had: at this
                size the show is carried by motion and light, not linework. */}
            <svg class="bot" viewBox="0 0 64 74" width="58" height="67" aria-hidden="true" focusable="false">
              <circle class="bot__halo" cx="32" cy="5" r="6.5" />
              <line class="bot__stalk" x1="32" y1="15" x2="32" y2="7" />
              <circle class="bot__spark" cx="32" cy="5" r="3.2" />
              <rect class="bot__head" x="9" y="15" width="46" height="33" rx="11" />
              <rect class="bot__visor" x="14" y="21" width="36" height="21" rx="9" />
              <g class="bot__eyes">
                <circle cx="25" cy="31.5" r="3.5" />
                <circle cx="39" cy="31.5" r="3.5" />
              </g>
              <path class="bot__neck" d="M32 48 V51" />
              <rect class="bot__body" x="14" y="51" width="36" height="19" rx="8" />
              {/* Chest emblem: a soft reactor glow with a chunky W struck over
                  it. Geometry, not type — at 58px wide a font turns to mush. */}
              <circle class="bot__core" cx="32" cy="60.5" r="8" />
              <path class="bot__w" d="M24.6 55.8 L27.4 65.2 L32 59.2 L36.6 65.2 L39.4 55.8" />
              <path class="bot__arm" d="M14 58 H7" />
              {/* The right arm ends in the emitter the bolts leave from. */}
              <path class="bot__arm" d="M50 58 H57" />
              <circle class="bot__muzzle" cx="58.6" cy="58" r="2.4" />
              <circle class="bot__muzzleLit" cx="58.6" cy="58" r="1.1" />
            </svg>

            {/* The show. A zero-size point at the emitter; everything hangs
                off it and nothing takes a pointer event. The effects reach
                far past the bot's own footprint. */}
            <span class="fx" data-fx>
              <span class="charge"></span>
              <span class="bloom"></span>
              {/* Three bolts, so a burst can have more than one slug in the
                  air at a time. Each carries its own angle and travel. */}
              <span class="bolts" data-bolts>
                {
                  [0, 1, 2].map(() => (
                    <span class="bolt">
                      <span class="bolt__flash" />
                      <span class="bolt__fly">
                        <span class="bolt__trail" />
                        <span class="bolt__glow" />
                        <span class="bolt__hot" />
                      </span>
                    </span>
                  ))
                }
              </span>
              <span class="sparks">
                <i style="--dx: 46px; --dy: -26px"></i>
                <i style="--dx: 52px; --dy: 14px"></i>
                <i style="--dx: 26px; --dy: -36px"></i>
                <i style="--dx: 30px; --dy: 30px"></i>
                <i style="--dx: 64px; --dy: -6px"></i>
                <i style="--dx: 14px; --dy: 22px"></i>
                <i style="--dx: 18px; --dy: -18px"></i>
              </span>
            </span>
          </span>
        </span>
    </span>

    <span class="who__name mono" translate="no">{t('bot.name')}</span>
    <span class="vh">{t('bot.ask')}</span>
  </summary>

  <div class="scrim" data-scrim></div>

  <aside class="drawer" data-drawer aria-labelledby="wassit-title" tabindex="-1">
    <header class="drawer__head">
      <h2 class="drawer__title" id="wassit-title">{t('db.drawerTitle')}</h2>
      <button class="drawer__x" type="button" data-close disabled>
        <span aria-hidden="true">{'✕'}</span>
        <span class="vh">{t('bot.close')}</span>
      </button>
    </header>

    <p class="drawer__intro">{t('bot.intro')}</p>
    <p class="drawer__howto">{t('bot.howto')}</p>

    <ol class="qs">
      {
        QUERIES.map((query) => (
          <li class="q">
            <p class="q__label">{t(query.key)}</p>
            <code class="q__sql" data-sql translate="no">
              {query.sql}
            </code>
            <p class="q__acts">
              <button
                class="btn btn--primary q__btn"
                type="button"
                data-copy={query.sql}
                data-label={t('bot.copy')}
                data-done={t('bot.copied')}
                disabled
              >
                {t('bot.copy')}
              </button>
              <button class="btn btn--ghost q__btn" type="button" data-insert={query.sql} disabled>
                {t('bot.insert')}
              </button>
            </p>
          </li>
        ))
      }
    </ol>

    <footer class="drawer__foot">
      <a class="drawer__plain" href={localize('/overview', locale)}>{t('bot.plainLink')}</a>
      <button class="btn btn--ghost" type="button" data-close disabled>{t('bot.close')}</button>
    </footer>
  </aside>
</details>

<style>
  /* A full-screen layer that never swallows clicks. The bot inside it drifts;
     the drawer is a sibling, so the drift transform never contains it. */
  .wassit {
    position: fixed;
    inset: 0;
    z-index: 30;
    pointer-events: none;
  }

  /* ── The drifting trigger ─────────────────────────────────────── */
  .trigger {
    position: absolute;
    left: 0;
    top: 0;
    display: inline-grid;
    justify-items: start;
    gap: 0.35rem;
    padding: 0.25rem;
    border-radius: var(--radius);
    cursor: pointer;
    pointer-events: auto;
    list-style: none;
    animation: wassit-drift 64s ease-in-out infinite;
    will-change: transform;
  }
  .trigger::-webkit-details-marker {
    display: none;
  }
  .trigger::marker {
    content: '';
  }
  .trigger:hover,
  .trigger:focus-visible,
  .wassit.is-near .trigger {
    animation-play-state: paused;
  }

  /* No hover on a touch screen, so a drifting bot would be a moving target
     with no way to stop it. Park it there. */
  @media (hover: none) {
    .trigger {
      animation: none;
    }
  }
  .trigger:focus-visible {
    outline: 2px solid var(--mx);
    outline-offset: 4px;
  }
  .wassit[open] .trigger {
    animation-play-state: paused;
    /* Above the scrim: without JavaScript the bot itself is the way to
       close the drawer again. */
    z-index: 55;
  }

  /* Drift stays in the upper band so it never sits over the command bar,
     and the bar is painted above it anyway. */
  @keyframes wassit-drift {
    0% {
      transform: translate(5vw, 28vh);
    }
    16% {
      transform: translate(44vw, 25vh);
    }
    31% {
      transform: translate(77vw, 31vh);
    }
    48% {
      transform: translate(60vw, 46vh);
    }
    63% {
      transform: translate(24vw, 44vh);
    }
    81% {
      transform: translate(8vw, 33vh);
    }
    100% {
      transform: translate(5vw, 28vh);
    }
  }

  .bubble {
    position: relative;
    display: grid;
    gap: 0.1rem;
    max-width: 28ch;
    margin-left: 0.5rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid var(--line-hi);
    border-radius: 12px;
    background: var(--bg-elev);
    color: var(--text-hi);
    font-size: 0.92rem;
    line-height: 1.4;
    box-shadow: 0 18px 40px -26px #000;
  }
  .bubble::after {
    content: '';
    position: absolute;
    left: 1.4rem;
    bottom: -7px;
    width: 12px;
    height: 12px;
    background: var(--bg-elev);
    border-right: 1px solid var(--line-hi);
    border-bottom: 1px solid var(--line-hi);
    transform: rotate(45deg);
  }
  .bubble__nudge {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mx);
  }
  .wassit[open] .bubble {
    display: none;
  }

  .who {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .who__name {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    color: var(--muted);
    background: var(--bg);
    padding: 0.1rem 0.3rem;
    border-radius: 3px;
  }
  .trigger:hover .who__name {
    color: var(--mx);
  }

  /* ── The character ────────────────────────────────────────────── */

  /* Four nested layers so the animations never fight over `transform`:
     .stage boots once, .rig floats forever, .kick takes the recoil, and
     the svg sits still inside. */
  .stage {
    display: block;
    flex: none;
    animation: wassit-boot 1.05s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .rig {
    position: relative;
    display: block;
    animation: wassit-float 5.3s ease-in-out infinite;
    will-change: transform;
  }
  .kick {
    position: relative;
    display: block;
  }
  .bot {
    display: block;
    filter: drop-shadow(0 10px 18px rgba(0, 0, 0, 0.55));
  }

  .bot__head,
  .bot__body {
    fill: var(--bg-elev);
    stroke: var(--mx);
    stroke-width: 1.6;
  }
  .bot__visor {
    fill: var(--bg-sunken);
    stroke: var(--mx-deep);
    stroke-width: 1.2;
  }
  .bot__eyes circle {
    fill: var(--mx-soft);
    animation: wassit-blink 11s steps(1, end) infinite;
    transform-box: fill-box;
    transform-origin: center;
  }
  /* Second eye on a different, co-prime cycle — the pair drifts in and out
     of sync, so the blink never reads as a loop. */
  .bot__eyes circle:last-child {
    animation-duration: 11.7s;
  }
  .bot__spark {
    fill: var(--violet);
    animation: wassit-spark 3.4s ease-in-out infinite;
    transform-box: fill-box;
    transform-origin: center;
  }
  .bot__halo {
    fill: var(--violet);
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: wassit-halo 3.4s ease-in-out infinite;
  }
  /* The reactor behind the emblem: blurred, dim, and slowly breathing, so
     the W sits on light rather than on a flat panel. */
  .bot__core {
    fill: var(--violet);
    opacity: 0.18;
    filter: blur(2.6px);
    transform-box: fill-box;
    transform-origin: center;
    animation: wassit-core 2.6s ease-in-out infinite;
  }
  /* Chunky, geometric, round-joined: miter spikes alias to nothing at this
     size, round ones stay solid. */
  .bot__w {
    fill: none;
    stroke: var(--mx-soft);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 2px var(--mx-deep));
  }
  .trigger:hover .bot__w {
    stroke: #fff;
  }
  .bot__stalk,
  .bot__neck,
  .bot__arm {
    stroke: var(--mx-deep);
    stroke-width: 1.8;
    stroke-linecap: round;
    fill: none;
  }
  .bot__muzzle {
    fill: var(--bg-sunken);
    stroke: var(--mx-deep);
    stroke-width: 1.1;
  }
  .bot__muzzleLit {
    fill: var(--mx);
    opacity: 0.75;
  }
  .trigger:hover .bot__head,
  .trigger:hover .bot__body {
    stroke: var(--mx-soft);
  }

  /* A slow "powering" pulse ring behind the whole bot. */
  .hum {
    position: absolute;
    left: 50%;
    top: 56%;
    width: 72%;
    aspect-ratio: 1;
    margin: -36% 0 0 -36%;
    border: 1px solid var(--mx);
    border-radius: 50%;
    opacity: 0;
    pointer-events: none;
    animation: wassit-hum 4.6s ease-out infinite;
  }

  /* Data packets shed behind it as it drifts. */
  .packets {
    position: absolute;
    left: 6%;
    top: 58%;
    pointer-events: none;
  }
  .packets i {
    position: absolute;
    width: 4px;
    height: 4px;
    background: var(--mx);
    box-shadow: 0 0 6px var(--mx);
    opacity: 0;
    animation: wassit-packet 3.8s linear infinite;
  }
  .packets i:nth-child(2) {
    top: 12px;
    animation-duration: 4.9s;
    animation-delay: 1.3s;
    background: var(--violet);
    box-shadow: 0 0 6px var(--violet);
  }
  .packets i:nth-child(3) {
    top: -14px;
    animation-duration: 5.7s;
    animation-delay: 2.6s;
  }

  /* ── The show ─────────────────────────────────────────────────── */

  /* A zero-size origin pinned to the emitter (58.6/64 across, 58/74 down
     of the svg box). It is deliberately NOT rotated: each bolt carries its
     own angle, so a bolt already in the air never swings when the next one
     launches on a different line. The bot is small; the show is not, so
     these lengths are in screen px, not svg units. */
  .fx {
    --hot: color-mix(in srgb, var(--mx-soft) 28%, #fff);
    --warm: var(--mx-soft);
    --cool: var(--mx);
    position: absolute;
    left: 91.6%;
    top: 78.4%;
    width: 0;
    height: 0;
    pointer-events: none;
  }
  .fx * {
    pointer-events: none;
  }
  .fx[data-hue='violet'] {
    --hot: color-mix(in srgb, var(--violet) 26%, #fff);
    --warm: var(--violet);
    --cool: var(--violet-deep);
  }

  /* Wind-up: a charge bulb swelling at the muzzle. */
  .charge {
    position: absolute;
    left: -9px;
    top: -9px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--hot) 0%, var(--warm) 45%, transparent 72%);
    opacity: 0;
    transform: scale(0.1);
  }
  .stage.is-charging .charge {
    animation: wassit-charge 430ms ease-in forwards;
  }

  /* ── The bolt ─────────────────────────────────────────────────
     A blaster slug, not a beam. Three layers of job separation so no two
     animations fight over `transform`:
       .bolt      — static rotation to the shot's line, animates opacity
       .bolt__fly — the only thing that moves: translateX 0 → --len
       children   — the slug's own look, never animated
     The slug keeps its short length for the whole flight; only its
     position changes. */
  .bolts {
    position: absolute;
    left: 0;
    top: 0;
  }
  .bolt {
    --ba: 0deg;
    --len: 380px;
    --dur: 400ms;
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    opacity: 0;
    transform: rotate(var(--ba));
  }
  .bolt.is-live {
    animation: wassit-bolt var(--dur) linear forwards;
  }
  .bolt__fly {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    transform: translateX(0);
  }
  .bolt.is-live .bolt__fly {
    animation: wassit-fly var(--dur) linear forwards;
  }

  /* Hot white core — short and hard-edged, this is what reads as a slug. */
  .bolt__hot {
    position: absolute;
    left: -6px;
    top: -2.1px;
    width: 20px;
    height: 4.2px;
    border-radius: 2.1px;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--hot) 55%, transparent) 0%,
      #fff 34%,
      #fff 72%,
      var(--hot) 100%
    );
    box-shadow:
      0 0 6px #fff,
      0 0 14px var(--warm),
      0 0 26px color-mix(in srgb, var(--cool) 80%, transparent);
  }
  /* The coloured halo it flies inside. */
  .bolt__glow {
    position: absolute;
    left: -13px;
    top: -6.5px;
    width: 34px;
    height: 13px;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at 58% 50%,
      var(--hot) 0%,
      color-mix(in srgb, var(--warm) 85%, transparent) 38%,
      color-mix(in srgb, var(--cool) 60%, transparent) 68%,
      transparent 100%
    );
    filter: blur(2.5px);
    opacity: 1;
  }
  /* A short wake, not a beam: it ends well before the muzzle. */
  .bolt__trail {
    position: absolute;
    left: -48px;
    top: -1.8px;
    width: 46px;
    height: 3.6px;
    border-radius: 1.8px;
    background: linear-gradient(
      90deg,
      transparent 0%,
      color-mix(in srgb, var(--cool) 40%, transparent) 42%,
      color-mix(in srgb, var(--warm) 92%, transparent) 100%
    );
    filter: blur(2.2px);
  }
  /* Directional muzzle flare, pinned to the launch point on the bolt's
     own line, so each shot in a burst flashes along its own angle. */
  .bolt__flash {
    position: absolute;
    left: -4px;
    top: -7px;
    width: 30px;
    height: 14px;
    border-radius: 50%;
    background: radial-gradient(
      ellipse at 12% 50%,
      #fff 0%,
      var(--hot) 24%,
      color-mix(in srgb, var(--warm) 70%, transparent) 50%,
      transparent 78%
    );
    opacity: 0;
    transform: scaleX(0.3);
    transform-origin: 0 50%;
  }
  .bolt.is-live .bolt__flash {
    animation: wassit-flash 180ms ease-out forwards;
  }

  /* Muzzle bloom — bright flash with a slow afterglow tail. */
  .bloom {
    position: absolute;
    left: -16px;
    top: -16px;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: radial-gradient(circle, #fff 0%, var(--hot) 28%, var(--cool) 52%, transparent 74%);
    opacity: 0;
    transform: scale(0.2);
  }
  .fx.is-shot .bloom {
    animation: wassit-bloom 620ms ease-out forwards;
  }

  .sparks {
    position: absolute;
    left: 0;
    top: 0;
  }
  .sparks i {
    position: absolute;
    left: -1.5px;
    top: -1.5px;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--hot);
    box-shadow: 0 0 5px var(--warm);
    opacity: 0;
  }
  .fx.is-shot .sparks i {
    animation: wassit-spark-fly 480ms ease-out forwards;
  }
  .fx.is-shot .sparks i:nth-child(even) {
    animation-duration: 600ms;
  }
  .fx.is-shot .sparks i:nth-child(3n) {
    animation-delay: 40ms;
  }

  /* Wind-up tells on the body itself. */
  .stage.is-charging .bot__eyes circle {
    animation: wassit-eye-charge 430ms ease-in forwards;
  }
  .stage.is-charging .bot__spark {
    animation: wassit-spark-fast 110ms steps(2, end) infinite;
  }
  .stage.is-charging .bot__halo {
    animation: wassit-halo-charge 430ms ease-in forwards;
  }
  .stage.is-charging .bot__muzzleLit {
    animation: wassit-muzzle-charge 430ms ease-in forwards;
  }
  .stage.is-charging .kick {
    animation: wassit-lean 430ms ease-out forwards;
  }
  /* The emblem takes the charge too: it lights with the reactor. */
  .stage.is-charging .bot__w {
    animation: wassit-w-charge 430ms ease-in forwards;
  }
  /* Cool-down: eyes and emblem settle back. */
  .stage.is-cool .bot__eyes circle {
    animation: wassit-eye-cool 520ms ease-out forwards;
  }
  .stage.is-cool .bot__w {
    animation: wassit-w-cool 560ms ease-out forwards;
  }
  .kick.is-recoil {
    animation: wassit-recoil 420ms cubic-bezier(0.22, 0.9, 0.2, 1);
  }

  /* ── Keyframes ────────────────────────────────────────────────── */

  @keyframes wassit-boot {
    0% {
      opacity: 0;
      transform: translateY(6px) scale(0.55);
    }
    45% {
      opacity: 1;
      transform: translateY(0) scale(1.06);
    }
    62% {
      transform: scale(0.97);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }
  @keyframes wassit-float {
    0%,
    100% {
      transform: translateY(0) rotate(-0.6deg);
    }
    38% {
      transform: translateY(-5px) rotate(0.8deg);
    }
    70% {
      transform: translateY(-2px) rotate(-0.3deg);
    }
  }
  /* Irregular on purpose: two quick blinks, a long pause, one slow blink. */
  @keyframes wassit-blink {
    0%,
    21%,
    24%,
    28%,
    31%,
    72%,
    78%,
    100% {
      transform: scaleY(1);
    }
    22%,
    23%,
    29%,
    30%,
    74%,
    76% {
      transform: scaleY(0.06);
    }
  }
  @keyframes wassit-spark {
    0%,
    100% {
      opacity: 0.55;
      transform: scale(0.82);
    }
    50% {
      opacity: 1;
      transform: scale(1.12);
    }
  }
  @keyframes wassit-halo {
    0%,
    100% {
      opacity: 0.06;
      transform: scale(0.7);
    }
    50% {
      opacity: 0.22;
      transform: scale(1);
    }
  }
  @keyframes wassit-core {
    0%,
    100% {
      opacity: 0.12;
      transform: scale(0.86);
    }
    50% {
      opacity: 0.28;
      transform: scale(1.06);
    }
  }
  @keyframes wassit-hum {
    0% {
      opacity: 0;
      transform: scale(0.52);
    }
    18% {
      opacity: 0.28;
    }
    100% {
      opacity: 0;
      transform: scale(1.22);
    }
  }
  @keyframes wassit-packet {
    0% {
      opacity: 0;
      transform: translate(0, 0) scale(1);
    }
    12% {
      opacity: 0.9;
    }
    100% {
      opacity: 0;
      transform: translate(-54px, 10px) scale(0.5);
    }
  }
  @keyframes wassit-charge {
    0% {
      opacity: 0;
      transform: scale(0.1);
    }
    55% {
      opacity: 0.85;
      transform: scale(0.8);
    }
    88% {
      opacity: 1;
      transform: scale(1.5);
    }
    100% {
      opacity: 0.9;
      transform: scale(0.6);
    }
  }
  /* The flight. Linear: a projectile does not ease. */
  @keyframes wassit-fly {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(var(--len));
    }
  }
  /* It winks in at the muzzle and burns out near the end of its travel. */
  @keyframes wassit-bolt {
    0% {
      opacity: 0;
    }
    7% {
      opacity: 1;
    }
    76% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes wassit-flash {
    0% {
      opacity: 0;
      transform: scaleX(0.3);
    }
    18% {
      opacity: 1;
      transform: scaleX(1);
    }
    100% {
      opacity: 0;
      transform: scaleX(1.5);
    }
  }
  @keyframes wassit-bloom {
    0% {
      opacity: 0;
      transform: scale(0.2);
    }
    10% {
      opacity: 1;
      transform: scale(1.35);
    }
    40% {
      opacity: 0.35;
      transform: scale(0.95);
    }
    100% {
      opacity: 0;
      transform: scale(1.8);
    }
  }
  @keyframes wassit-spark-fly {
    0% {
      opacity: 0;
      transform: translate(0, 0) scale(1.4);
    }
    8% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translate(var(--dx), var(--dy)) scale(0.2);
    }
  }
  @keyframes wassit-spark-fast {
    0%,
    100% {
      opacity: 1;
      transform: scale(1.35);
    }
    50% {
      opacity: 0.35;
      transform: scale(0.9);
    }
  }
  @keyframes wassit-halo-charge {
    0% {
      opacity: 0.1;
      transform: scale(0.7);
    }
    100% {
      opacity: 0.55;
      transform: scale(1.35);
    }
  }
  @keyframes wassit-eye-charge {
    0% {
      fill: var(--mx-soft);
    }
    100% {
      fill: #fff;
      filter: drop-shadow(0 0 5px var(--mx-soft));
    }
  }
  @keyframes wassit-eye-cool {
    0% {
      fill: #fff;
      filter: drop-shadow(0 0 5px var(--mx-soft));
    }
    100% {
      fill: var(--mx-soft);
      filter: none;
    }
  }
  @keyframes wassit-w-charge {
    0% {
      stroke: var(--mx-soft);
      filter: drop-shadow(0 0 2px var(--mx-deep));
    }
    100% {
      stroke: #fff;
      filter: drop-shadow(0 0 6px var(--mx-soft));
    }
  }
  @keyframes wassit-w-cool {
    0% {
      stroke: #fff;
      filter: drop-shadow(0 0 6px var(--mx-soft));
    }
    100% {
      stroke: var(--mx-soft);
      filter: drop-shadow(0 0 2px var(--mx-deep));
    }
  }
  @keyframes wassit-muzzle-charge {
    0% {
      opacity: 0.75;
    }
    100% {
      opacity: 1;
      r: 1.9;
    }
  }
  @keyframes wassit-lean {
    0% {
      transform: translateX(0) rotate(0);
    }
    100% {
      transform: translateX(3px) rotate(2deg);
    }
  }
  /* Recoil plus a short, jittery shake — on the bot, never the page. */
  @keyframes wassit-recoil {
    0% {
      transform: translate(0, 0) rotate(0);
    }
    8% {
      transform: translate(-9px, 1px) rotate(-4.5deg);
    }
    16% {
      transform: translate(-5px, -3px) rotate(-1.8deg);
    }
    24% {
      transform: translate(-7px, 2px) rotate(-3.2deg);
    }
    34% {
      transform: translate(-2px, -1px) rotate(-0.6deg);
    }
    46% {
      transform: translate(3px, 1px) rotate(1.4deg);
    }
    58% {
      transform: translate(-1px, -1px) rotate(-0.5deg);
    }
    74% {
      transform: translate(1px, 0) rotate(0.3deg);
    }
    100% {
      transform: translate(0, 0) rotate(0);
    }
  }
  @keyframes wassit-slide {
    from {
      transform: translateX(100%);
    }
    to {
      transform: translateX(0);
    }
  }

  /* Hovered, focused, drawer open or tab hidden: the whole show holds
     still. The drift already paused in the first two; everything else
     matches it now, and a hidden tab costs nothing. */
  .trigger:hover .rig,
  .wassit.is-near .rig,
  .trigger:focus-visible .rig,
  .wassit[open] .rig,
  .wassit.is-dormant .rig,
  .trigger:hover .hum,
  .trigger:focus-visible .hum,
  .wassit[open] .hum,
  .wassit.is-dormant .hum,
  .trigger:hover .packets i,
  .trigger:focus-visible .packets i,
  .wassit[open] .packets i,
  .wassit.is-dormant .packets i,
  .wassit.is-dormant .trigger,
  .wassit.is-dormant .bot__eyes circle,
  .wassit.is-dormant .bot__spark,
  .wassit.is-dormant .bot__halo,
  .wassit.is-dormant .bot__core {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .trigger {
      animation: none;
      transform: translate(calc(100vw - 15rem), 28vh);
    }
    /* Everything parks. No float, no blink, no drift, no packets, and the
       effect layer is not merely still but gone. */
    .stage,
    .rig,
    .hum,
    .packets i,
    .bot__eyes circle,
    .bot__spark,
    .bot__halo,
    .bot__core,
    .bot__w,
    .kick,
    .drawer {
      animation: none !important;
    }
    .hum,
    .packets,
    .fx {
      display: none;
    }
  }

  /* ── Drawer ───────────────────────────────────────────────────── */
  .scrim {
    position: fixed;
    inset: 0;
    z-index: 50;
    background: rgba(4, 6, 10, 0.66);
    pointer-events: auto;
  }
  .drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    width: min(27rem, 94vw);
    overflow-y: auto;
    overscroll-behavior: contain;
    pointer-events: auto;
    background: var(--bg-elev);
    border-left: 1px solid var(--line-hi);
    box-shadow: -30px 0 60px -30px #000;
    padding: 1rem 1.1rem 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    animation: wassit-slide 0.26s ease-out;
    scrollbar-width: thin;
    scrollbar-color: var(--mx-deep) transparent;
  }
  .drawer:focus {
    outline: none;
  }
  .drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    position: sticky;
    top: -1rem;
    margin: -1rem -1.1rem 0;
    padding: 1rem 1.1rem 0.6rem;
    background: var(--bg-elev);
    z-index: 1;
  }
  .drawer__title {
    margin: 0;
    font-size: 0.95rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .drawer__x {
    border: 1px solid var(--line-dim);
    background: transparent;
    color: var(--muted);
    border-radius: 4px;
    width: 2rem;
    height: 2rem;
    cursor: pointer;
    font-size: 0.9rem;
    line-height: 1;
  }
  .drawer__x:hover {
    color: var(--mx);
    border-color: var(--mx);
  }
  .drawer__intro {
    margin: 0;
    color: var(--text-hi);
    font-size: 0.95rem;
  }
  .drawer__howto {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
  }

  .qs {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  /* One query per row. */
  .q {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
    border: 1px solid var(--line-dim);
    border-radius: var(--radius);
    background: var(--bg-sunken);
    padding: 0.6rem 0.7rem;
  }
  .q__label {
    margin: 0;
    color: var(--text-hi);
    font-weight: 600;
    font-size: 0.9rem;
  }
  .q__sql {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.5;
    color: var(--mx-soft);
    background: var(--bg);
    border: 1px solid var(--line-dim);
    border-radius: 4px;
    padding: 0.35rem 0.45rem;
    overflow-wrap: anywhere;
    user-select: all;
  }
  .q__acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
  }
  .q__btn {
    font-size: 0.74rem;
    padding: 0.35rem 0.65rem;
  }
  .q__btn[disabled] {
    opacity: 0.55;
    cursor: default;
  }

  .drawer__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-top: 0.6rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line-dim);
  }
  .drawer__plain {
    font-size: 0.85rem;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 560px) {
    .bubble {
      font-size: 0.85rem;
      max-width: 24ch;
    }
    /* Smaller orbit on a phone, well clear of the command bar. */
    @keyframes wassit-drift {
      0% {
        transform: translate(3vw, 26vh);
      }
      25% {
        transform: translate(40vw, 22vh);
      }
      50% {
        transform: translate(26vw, 40vh);
      }
      75% {
        transform: translate(5vw, 34vh);
      }
      100% {
        transform: translate(3vw, 26vh);
      }
    }
  }
</style>

<script>
  const wassit = document.querySelector<HTMLDetailsElement>('[data-wassit]');

  if (wassit) {
    const trigger = wassit.querySelector<HTMLElement>('[data-trigger]')!;
    const drawer = wassit.querySelector<HTMLElement>('[data-drawer]')!;
    const scrim = wassit.querySelector<HTMLElement>('[data-scrim]')!;
    const ask = wassit.querySelector<HTMLElement>('[data-ask]')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const reopenLabel = wassit.dataset.reopen;

    for (const button of wassit.querySelectorAll<HTMLButtonElement>('button[disabled]')) {
      button.disabled = false;
    }

    let opened = false;

    wassit.addEventListener('toggle', () => {
      trigger.setAttribute('aria-expanded', String(wassit.open));
      if (wassit.open) {
        opened = true;
        drawer.focus({ preventScroll: true });
      } else if (opened && reopenLabel) {
        // Once dismissed, the bubble offers its way back.
        ask.textContent = reopenLabel;
      }
    });

    /** `handBack` returns focus to the bot; insert hands it to the prompt. */
    function dismiss(handBack = true) {
      if (!wassit.open) return;
      wassit.open = false;
      if (handBack) trigger.focus();
    }

    for (const button of wassit.querySelectorAll<HTMLButtonElement>('[data-close]')) {
      button.addEventListener('click', () => dismiss());
    }
    scrim.addEventListener('click', () => dismiss());

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && wassit.open) dismiss();
    });

    /* ── Copy ──────────────────────────────────────────────────── */

    function selectText(node: Element) {
      const selection = window.getSelection();
      if (!selection) return;
      const range = document.createRange();
      range.selectNodeContents(node);
      selection.removeAllRanges();
      selection.addRange(range);
    }

    async function toClipboard(text: string): Promise<boolean> {
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(text);
          return true;
        }
      } catch {
        /* fall through to the legacy path */
      }
      try {
        const scratch = document.createElement('textarea');
        scratch.value = text;
        scratch.setAttribute('readonly', '');
        scratch.style.position = 'fixed';
        scratch.style.top = '0';
        scratch.style.opacity = '0';
        document.body.append(scratch);
        scratch.select();
        const ok = document.execCommand('copy');
        scratch.remove();
        return ok;
      } catch {
        return false;
      }
    }

    for (const button of wassit.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
      button.addEventListener('click', async () => {
        const done = await toClipboard(button.dataset.copy ?? '');
        if (done) {
          button.textContent = button.dataset.done ?? '';
          window.setTimeout(
            () => {
              button.textContent = button.dataset.label ?? '';
            },
            reduceMotion ? 1200 : 1600
          );
        } else {
          // Clipboard refused: select the SQL so Ctrl+C still works.
          const sqlNode = button.closest('.q')?.querySelector('[data-sql]');
          if (sqlNode) selectText(sqlNode);
        }
      });
    }

    /* ── Insert at the prompt — never run ──────────────────────── */

    for (const button of wassit.querySelectorAll<HTMLButtonElement>('[data-insert]')) {
      button.addEventListener('click', () => {
        dismiss(false);
        document.dispatchEvent(
          new CustomEvent('db:insert', { detail: button.dataset.insert ?? '' })
        );
      });
    }

    /* ── The laser show ───────────────────────────────────────────
       Pure spectacle. The bolt hits nothing, targets nothing and tells
       nothing else on the page that it happened: no query, no selection,
       no highlight. Every layer it draws is aria-hidden and
       pointer-events: none, so it cannot be heard or clicked.

       Timing lives in setTimeout, never in requestAnimationFrame — the
       bot is idle between shows, so there is nothing to tick. The motion
       itself is CSS. */

    const stage = wassit.querySelector<HTMLElement>('[data-stage]');
    const kick = wassit.querySelector<HTMLElement>('[data-kick]');
    const fx = wassit.querySelector<HTMLElement>('[data-fx]');
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const bolts = fx ? [...fx.querySelectorAll<HTMLElement>('.bolt')] : [];

    if (stage && kick && fx && bolts.length) {
      type Shot = { shots: number; angle: number; len: number; hue: string };

      /* Repeat viewers get a different show: angle, travel, colour and shot
         count all move. Angles stay shallow — a steep one would climb into
         the bot's own speech bubble; downward is clear board. `len` is how
         far the bolt travels, not how long it is. */
      const VARIANTS: Shot[] = [
        { shots: 1, angle: -9, len: 420, hue: 'teal' },
        { shots: 1, angle: 12, len: 360, hue: 'teal' },
        { shots: 1, angle: -3, len: 470, hue: 'teal' },
        { shots: 2, angle: 6, len: 340, hue: 'teal' },
        { shots: 1, angle: -11, len: 400, hue: 'violet' },
        { shots: 3, angle: 9, len: 310, hue: 'teal' },
      ];

      const WINDUP = 430;
      /* Shorter than a bolt's flight on purpose: a burst puts two slugs in
         the air at once, which is what reads as repeat fire. */
      const GAP = 190;
      const TAIL = 760;
      /** Screen px per millisecond. Snappy, but trackable by eye. */
      const SPEED = 0.95;

      let pending: number[] = [];
      let loop = 0;
      let busy = false;

      /** Re-triggers a CSS animation that may already be on the element. */
      function restart(el: HTMLElement, cls: string) {
        el.classList.remove(cls);
        void el.offsetWidth;
        el.classList.add(cls);
      }

      /** Mirrors the show onto the root, where it is observable in one place. */
      function mark(phase: string) {
        if (phase) wassit!.dataset.show = phase;
        else delete wassit!.dataset.show;
      }

      function shoot(shot: Shot, index: number) {
        // Later shots in a burst wander a little off the first angle,
        // within the band that stays clear of the bubble.
        const drift = index === 0 ? 0 : Math.round(Math.random() * 14 - 7);
        const angle = Math.min(20, Math.max(-12, shot.angle + drift));
        const len = Math.round(shot.len * (index ? 0.88 : 1));
        fx!.dataset.hue = shot.hue;

        // Its own element per shot, so a slug still in flight is never
        // re-aimed or cut short by the next one leaving the muzzle.
        const bolt = bolts[index % bolts.length];
        bolt.style.setProperty('--ba', `${angle}deg`);
        bolt.style.setProperty('--len', `${len}px`);
        bolt.style.setProperty('--dur', `${Math.round(len / SPEED)}ms`);
        restart(bolt, 'is-live');

        restart(fx!, 'is-shot');
        restart(kick!, 'is-recoil');
        mark('shot');
      }

      function clearPending() {
        for (const id of pending) window.clearTimeout(id);
        pending = [];
      }

      /** Back to a parked idle, mid-show if need be. */
      function reset() {
        clearPending();
        busy = false;
        stage!.classList.remove('is-charging', 'is-cool');
        fx!.classList.remove('is-shot');
        kick!.classList.remove('is-recoil');
        for (const bolt of bolts) bolt.classList.remove('is-live');
        mark('');
      }

      function fire(forced?: Shot) {
        if (busy || motion.matches || held()) return;
        busy = true;
        const shot = forced ?? VARIANTS[Math.floor(Math.random() * VARIANTS.length)];
        let index = 0;

        // 1. wind-up — eyes, antenna and chest emblem brighten
        stage!.classList.remove('is-cool');
        stage!.classList.add('is-charging');
        mark('charging');

        pending.push(
          window.setTimeout(function next() {
            // 2. bolt launches + muzzle flare + sparks, 3. recoil kick
            if (index === 0) stage!.classList.remove('is-charging');
            shoot(shot, index);
            index += 1;
            if (index < shot.shots) {
              pending.push(window.setTimeout(next, GAP));
              return;
            }
            // 4. cool-down
            stage!.classList.add('is-cool');
            mark('cool');
            pending.push(
              window.setTimeout(() => {
                stage!.classList.remove('is-cool');
                fx!.classList.remove('is-shot');
                kick!.classList.remove('is-recoil');
                for (const bolt of bolts) bolt.classList.remove('is-live');
                busy = false;
                mark('');
              }, TAIL)
            );
          }, WINDUP)
        );
      }

      /**
       * The bot drifts, which made it genuinely hard to click: by the time you
       * had aimed it had moved, and :hover only fires once you are already on
       * it — the very thing you cannot manage. So it stops as you *approach*,
       * well before the pointer arrives.
       */
      {
        const NEAR = 150; // px from the bot's centre
        let queued = false;

        const settleNear = (event: PointerEvent) => {
          queued = false;
          const svg = trigger.querySelector('svg');
          if (!svg) return;
          const r = svg.getBoundingClientRect();
          const dx = event.clientX - (r.left + r.width / 2);
          const dy = event.clientY - (r.top + r.height / 2);
          wassit!.classList.toggle('is-near', Math.hypot(dx, dy) < NEAR);
        };

        document.addEventListener(
          'pointermove',
          (event) => {
            // Coalesce to one measurement per frame; this runs on every move.
            if (queued || event.pointerType === 'touch') return;
            queued = true;
            requestAnimationFrame(() => settleNear(event));
          },
          { passive: true }
        );

        // Never leave it stuck paused when the pointer leaves the window.
        document.addEventListener('pointerleave', () => wassit!.classList.remove('is-near'));
      }

      function schedule(min: number, max: number) {
        window.clearTimeout(loop);
        if (motion.matches) return;
        loop = window.setTimeout(tick, min + Math.random() * (max - min));
      }

      /** Hold the show whenever it would be in the way or unseen. */
      function held() {
        return (
          document.hidden ||
          wassit!.open ||
          trigger.matches(':hover') ||
          wassit!.classList.contains('is-near') ||
          trigger.contains(document.activeElement)
        );
      }

      function tick() {
        if (held()) {
          // Try again soon rather than skipping a whole cycle.
          schedule(5000, 9000);
          return;
        }
        fire();
        schedule(15000, 30000);
      }

      // Opening the drawer cuts a show that is already in flight: the bot
      // sits above the scrim, so a bolt there would play over the UI.
      wassit.addEventListener('toggle', () => {
        if (wassit.open) {
          window.clearTimeout(loop);
          reset();
        } else {
          schedule(9000, 18000);
        }
      });

      // A hook for QA only: nothing in the UI dispatches this.
      document.addEventListener('wassit:fire', (event) => {
        const detail = (event as CustomEvent).detail;
        fire(detail && typeof detail === 'object' ? (detail as Shot) : undefined);
      });

      /** Follows the tab. Hidden: no timer, no show, animations parked. */
      function syncVisibility(min: number, max: number) {
        wassit!.classList.toggle('is-dormant', document.hidden);
        if (document.hidden) {
          window.clearTimeout(loop);
          reset();
        } else {
          schedule(min, max);
        }
      }

      document.addEventListener('visibilitychange', () => syncVisibility(8000, 16000));

      // Reduced motion flipped on mid-visit: stop, park, stay parked.
      motion.addEventListener('change', () => {
        if (motion.matches) {
          window.clearTimeout(loop);
          reset();
        } else {
          schedule(10000, 20000);
        }
      });

      // First show lands soon enough to be discovered, then it settles into
      // the slow cadence. Never starts at all under reduced motion, and a
      // page that loads in a background tab starts dormant — no
      // visibilitychange fires for a tab that was already hidden.
      syncVisibility(8000, 14000);
    }
  }
</script>
