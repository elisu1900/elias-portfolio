---
/**
 * The landing screen: the portfolio as a relational database, on one locked
 * screen.
 *
 * This is not a page you scroll — it is a black whiteboard you pan around.
 * The schema board fills the viewport edge to edge and every piece of UI
 * floats over it: the title top-left, the escape hatch top-right, the command
 * line pinned to the bottom with its single result panel rising above it, and
 * mini-wassit drifting in between.
 *
 * The chrome layer is `pointer-events: none`, with `auto` on the actual
 * controls, so dragging the board works in the gaps between the overlays.
 * Everything but query execution is server-rendered.
 */
import SchemaDiagram from './SchemaDiagram.astro';
import CommandBar from './CommandBar.astro';
import MiniWassit from './MiniWassit.astro';
import { useT, localize } from '../../i18n/utils';
import type { Locale } from '../../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useT(locale);
---

<div class="screen">
  <SchemaDiagram locale={locale} />

  <div class="chrome" data-screen-chrome>
    <div class="chrome__copy">
      <h1 class="screen__title">{t('db.title')}</h1>
      <p class="screen__sub">{t('db.subtitle')}</p>
    </div>
    <p class="chrome__escape">
      <a class="btn btn--ghost" href={localize('/overview', locale)}>{t('db.notTechnical')}</a>
      <span class="screen__hint muted mono">{t('db.escapeHint')}</span>
    </p>
  </div>
</div>

<MiniWassit locale={locale} />
<CommandBar locale={locale} />

<style>
  /* One locked screen. No z-index here on purpose: the sticky nav must keep
     painting over the board, while the overlays inside are free to raise
     themselves above it. */
  .screen {
    position: fixed;
    inset: 0;
    overflow: hidden;
    overscroll-behavior: none;
  }

  /* -- Floating chrome -------------------------------------------- */

  /* Anchored under the nav and left to size itself, so it can never reach
     down over the command bar. Wrapping, so the two blocks never collide. */
  .chrome {
    --nav-h: 59px;
    position: absolute;
    top: calc(var(--nav-h) + clamp(0.5rem, 1.6vw, 1rem));
    left: clamp(0.6rem, 2vw, 1.4rem);
    right: clamp(0.6rem, 2vw, 1.4rem);
    z-index: 35;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.6rem 1.5rem;
    /* Empty space here belongs to the board underneath. */
    pointer-events: none;
  }

  .chrome__copy {
    min-width: 0;
    max-width: 40ch;
  }
  .screen__title {
    margin: 0;
    font-size: clamp(1.05rem, 2.1vw, 1.6rem);
    letter-spacing: -0.01em;
    text-shadow: 0 2px 18px #000;
  }
  .screen__sub {
    margin: 0.15rem 0 0;
    color: var(--muted);
    font-size: clamp(0.8rem, 1.2vw, 0.95rem);
    line-height: 1.5;
    text-shadow: 0 2px 14px #000;
  }

  .chrome__escape {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.3rem 0.7rem;
    margin: 0;
    margin-left: auto;
    text-align: right;
  }
  .chrome__escape a {
    pointer-events: auto;
  }
  .screen__hint {
    font-size: 0.7rem;
  }
</style>

