---
/**
 * The ER diagram, as an infinite black whiteboard you pan around.
 *
 * The board fills the viewport edge to edge: `.erd` is the still viewport that
 * clips and carries the dotted grid, `.erd__world` is the one element that gets
 * transformed, and `.erd__canvas` is the fixed-size diagram inside it. Nothing
 * here scrolls the page.
 *
 * Fully server-rendered from `schema` and `relations`, so it is there with
 * JavaScript switched off. Without JavaScript the board cannot be panned, so
 * `.erd` scrolls internally instead of trapping the diagram — the `js` class is
 * what switches it over to a pannable canvas.
 *
 * JavaScript adds the extras: pan/zoom, click-to-query, hover/focus
 * highlighting, and panning a table into view when it takes focus.
 *
 * Everything technical carries translate="no": browser auto-translation turns
 * `PK` into `PAQUETE` and table names into prose, which would wreck the point.
 */
import { buildDiagram } from '../../lib/diagram';
import { useT } from '../../i18n/utils';
import type { Locale } from '../../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useT(locale);
const diagram = buildDiagram(locale === 'es' ? 'es' : 'en');
---

<section class="pane" data-erd-root>
  <div
    class="erd"
    data-board
    role="group"
    aria-labelledby="erd-title erd-pan"
    tabindex="0"
    translate="no"
  >
    <div class="erd__world" data-world>
      <div class="erd__canvas" data-canvas style={`width:${diagram.width}px;height:${diagram.height}px`}>
        <svg
          class="erd__edges"
          width={diagram.width}
          height={diagram.height}
          viewBox={`0 0 ${diagram.width} ${diagram.height}`}
          aria-hidden="true"
          focusable="false"
        >
          {
            diagram.edges.map((edge) => (
              <g class="edge" data-a={edge.from} data-b={edge.to}>
                <title>{edge.label}</title>
                <path d={edge.d} />
                <circle class="edge__end" cx={edge.x1} cy={edge.y1} r="2.6" />
                <circle class="edge__end edge__end--pk" cx={edge.x2} cy={edge.y2} r="3.4" />
              </g>
            ))
          }
        </svg>

        {
          diagram.nodes.map((node) => (
            <article
              class="tnode"
              data-table={node.table}
              style={`left:${node.x}px;top:${node.y}px;width:${node.w}px`}
            >
              <button
                class="tnode__head mono"
                type="button"
                data-query={`SELECT * FROM ${node.table};`}
                title={node.comment}
                disabled
              >
                <span class="tnode__dot" aria-hidden="true" />
                <span class="tnode__name">{node.table}</span>
                <span class="tnode__count">{node.rows.length}</span>
              </button>
              <ul class="tnode__cols">
                {node.rows.map((row) => (
                  <li class:list={['crow', { 'is-pk': row.pk, 'is-fk': !!row.fk }]}>
                    <span class="crow__name">{row.name}</span>
                    <span class="crow__type">{row.type + (row.nullable ? '?' : '')}</span>
                    {row.pk && <span class="chip chip--pk">PK</span>}
                    {row.fk && (
                      <span class="chip chip--fk">
                        FK<span class="vh"> {'→'} {row.fk}</span>
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </div>

  <script is:inline>
    // Runs during parse, before the first paint: marks the board as scriptable
    // and holds the diagram back until the module below has fitted it, so it
    // never flashes as a static, clipped diagram. The timer is the safety net
    // if that module never arrives.
    (function () {
      var pane = document.currentScript.parentElement;
      pane.classList.add('js', 'is-booting');
      setTimeout(function () {
        pane.classList.remove('is-booting');
      }, 1500);
    })();
  </script>

  {/* Canvas chrome: floats over the board, above the command bar. */}
  <div class="cv" data-controls>
    <p class="cv__hint mono">
      {t('db.clickTable')}
      <span class="cv__sep" aria-hidden="true">·</span>
      <span class="cv__pan" id="erd-pan">{t('db.pan')}</span>
    </p>

    <div class="cv__meta">
      <h2 class="cv__title" id="erd-title">{t('db.schemaTitle')}</h2>

      <details class="tlist">
        <summary class="mono">
          {diagram.tableCount} {t('db.tables')} · {diagram.columnCount} {t('db.columns')}
        </summary>
        <ul>
          {
            diagram.nodes
              .slice()
              .sort((a, b) => a.table.localeCompare(b.table))
              .map((node) => (
                <li>
                  <code translate="no">{node.table}</code>
                  <span class="muted">{node.comment}</span>
                </li>
              ))
          }
        </ul>
      </details>
    </div>

    <div class="cv__zoom">
      <button class="cv__btn mono" type="button" data-zoom-out aria-label={t('db.zoomOut')} title={t('db.zoomOut')}>
        <span aria-hidden="true">−</span>
      </button>
      <button class="cv__btn mono" type="button" data-zoom-in aria-label={t('db.zoomIn')} title={t('db.zoomIn')}>
        <span aria-hidden="true">+</span>
      </button>
      <button class="cv__btn cv__btn--fit mono" type="button" data-fit aria-label={t('db.fit')} title={t('db.fit')}>
        <svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true" focusable="false">
          <path
            d="M2 6V2h4M14 6V2h-4M2 10v4h4M14 10v4h-4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
          />
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  .pane {
    /* A near-pure black board, deeper than the page --bg, with its own grid
       token. Local on purpose: global.css is not ours to touch. */
    --board-bg: #020305;
    --board-dot: rgba(127, 138, 163, 0.16);
    position: absolute;
    inset: 0;
    min-width: 0;
  }

  /* -- The still viewport: clips the board and carries the grid ---- */
  .erd {
    position: absolute;
    inset: 0;
    /* No JavaScript: the board cannot be panned, so let it scroll inside
       itself rather than hiding tables. */
    overflow: auto;
    overscroll-behavior: contain;
    background-color: var(--board-bg);
    background-image: radial-gradient(var(--board-dot) 1px, transparent 1px);
    /* Both driven by the board transform, so the surface moves with the
       diagram instead of sitting behind it. */
    background-size: var(--board-gap, 22px) var(--board-gap, 22px);
    background-position: var(--board-x, 0px) var(--board-y, 0px);
    scrollbar-width: thin;
    scrollbar-color: var(--mx-deep) transparent;
  }
  .erd::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }
  .erd::-webkit-scrollbar-thumb {
    background: var(--mx-deep);
    border-radius: 10px;
  }
  .erd:focus-visible {
    outline: 2px solid var(--mx);
    outline-offset: -2px;
  }

  /* With JavaScript it becomes a pannable canvas. */
  .pane.js .erd {
    overflow: hidden;
    touch-action: none;
    cursor: grab;
    /* A drag across the board pans it; it must never sweep a text
       selection through the table nodes. Selection stays available
       in the no-JS fallback, where the board does not pan. */
    user-select: none;
    -webkit-user-select: none;
  }
  .pane.js .erd.is-grabbing {
    cursor: grabbing;
  }

  /* -- The one transformed element -------------------------------- */
  .erd__world {
    position: absolute;
    left: 0;
    top: 0;
    transform-origin: 0 0;
  }
  .pane.js .erd__world {
    will-change: transform;
  }
  /* Held back until the first fit lands; the grid is already there. */
  .pane.is-booting .erd__world {
    visibility: hidden;
  }
  .erd__world.is-eased {
    transition: transform 0.22s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .erd__world.is-eased {
      transition: none;
    }
  }

  .erd__canvas {
    position: relative;
    flex: none;
  }
  .erd__edges {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  /* -- Edges ------------------------------------------------------- */
  .edge path {
    fill: none;
    stroke: var(--line-hi);
    stroke-width: 1.2;
    transition: stroke 0.18s ease, stroke-width 0.18s ease, opacity 0.18s ease;
  }
  .edge__end {
    fill: var(--board-bg);
    stroke: var(--line-hi);
    stroke-width: 1.2;
  }
  .edge__end--pk {
    fill: var(--mx-deep);
  }
  .has-hot .edge:not(.is-hot) path,
  .has-hot .edge:not(.is-hot) circle {
    opacity: 0.18;
  }
  .edge.is-hot path {
    stroke: var(--mx);
    stroke-width: 1.9;
  }
  .edge.is-hot circle {
    stroke: var(--mx);
  }

  /* -- Table nodes ------------------------------------------------- */
  .tnode {
    position: absolute;
    z-index: 2;
    background: var(--bg-card);
    border: 1px solid var(--line-dim);
    border-radius: 5px;
    overflow: hidden;
    font-family: var(--font-mono);
    transition: border-color 0.18s ease, box-shadow 0.18s ease, opacity 0.18s ease;
  }
  .has-hot .tnode:not(.is-hot):not(.is-near) {
    opacity: 0.45;
  }
  .tnode.is-near {
    border-color: var(--line-hi);
  }
  .tnode.is-hot {
    border-color: var(--mx);
    box-shadow:
      0 0 0 1px rgba(45, 212, 191, 0.35),
      0 14px 34px -18px #000;
  }

  .tnode__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 6px;
    width: 100%;
    height: 30px;
    padding: 0 8px;
    border: 0;
    border-bottom: 1px solid var(--line-dim);
    background: var(--bg-elev);
    color: var(--text-hi);
    font-family: inherit;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-align: left;
    cursor: pointer;
  }
  .tnode__head[disabled] {
    cursor: default;
  }
  .tnode__head:hover:not([disabled]) {
    background: rgba(45, 212, 191, 0.12);
    color: var(--mx-soft);
  }
  .tnode__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--mx);
    box-shadow: 0 0 0 2px rgba(45, 212, 191, 0.16);
  }
  .tnode__name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tnode__count {
    font-size: 9px;
    font-weight: 400;
    color: var(--muted);
  }

  .tnode__cols {
    list-style: none;
    margin: 0;
    padding: 0 0 8px;
  }
  .crow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto auto;
    align-items: center;
    gap: 5px;
    height: 21px;
    padding: 0 8px;
    font-size: 10.5px;
    line-height: 21px;
    color: var(--text);
  }
  .crow + .crow {
    border-top: 1px solid rgba(127, 138, 163, 0.07);
  }
  .crow.is-pk .crow__name {
    color: var(--text-hi);
  }
  .crow__name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .crow__type {
    font-size: 9.5px;
    color: var(--muted);
  }
  .chip {
    font-size: 8.5px;
    line-height: 13px;
    padding: 0 3px;
    border-radius: 3px;
    border: 1px solid;
    letter-spacing: 0.04em;
  }
  .chip--pk {
    color: var(--violet);
    border-color: rgba(167, 139, 250, 0.42);
  }
  .chip--fk {
    color: var(--amber);
    border-color: rgba(251, 191, 36, 0.34);
  }

  /* -- Canvas chrome ----------------------------------------------- */

  /* Floats bottom-left, lifted clear of the command bar — `--deck-h` is
     published by the command bar, so a tall result pushes this up rather
     than hiding under it. Empty space here passes clicks to the board. */
  .cv {
    position: fixed;
    left: clamp(0.6rem, 2vw, 1.4rem);
    bottom: calc(var(--deck-h, 5.6rem) + 0.5rem);
    z-index: 35;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    max-width: min(32rem, calc(100vw - 1.6rem));
    pointer-events: none;
  }

  .cv__hint {
    margin: 0;
    font-size: 0.7rem;
    line-height: 1.5;
    color: var(--mx);
  }
  .cv__sep {
    margin-inline: 0.35rem;
    color: var(--line-hi);
  }
  .cv__pan {
    color: var(--muted);
  }
  /* The pan hint is a lie without JavaScript, and so is the board's name
     if it mentions dragging: hide it, and the board is just "Schema". */
  .cv__sep,
  .cv__pan {
    display: none;
  }
  .pane.js .cv__sep {
    display: inline;
  }
  .pane.js .cv__pan {
    display: inline;
  }

  .cv__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.75rem;
  }
  .cv__title {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .cv__zoom {
    display: none;
    gap: 0.3rem;
    pointer-events: auto;
  }
  .pane.js .cv__zoom {
    display: flex;
  }
  .cv__btn {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border: 1px solid var(--line-hi);
    border-radius: 5px;
    background: rgba(13, 17, 25, 0.86);
    backdrop-filter: blur(6px);
    color: var(--text-hi);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
  }
  .cv__btn:hover {
    border-color: var(--mx);
    color: var(--mx);
  }
  .cv__btn--fit {
    color: var(--mx-soft);
  }

  /* -- Table list: a dropdown, opening upward off the chrome ------- */
  .tlist {
    position: relative;
    pointer-events: auto;
  }
  .tlist summary {
    cursor: pointer;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .tlist summary:hover {
    color: var(--mx);
  }
  .tlist ul {
    position: absolute;
    left: 0;
    bottom: calc(100% + 0.4rem);
    z-index: 20;
    width: min(30rem, 86vw);
    max-height: 46vh;
    overflow: auto;
    list-style: none;
    margin: 0;
    padding: 0.7rem 0.85rem;
    display: grid;
    gap: 0.3rem;
    background: var(--bg-elev);
    border: 1px solid var(--line-hi);
    border-radius: var(--radius);
    box-shadow: 0 24px 50px -24px #000;
  }
  .tlist li {
    display: grid;
    grid-template-columns: 10.5rem minmax(0, 1fr);
    gap: 0.6rem;
    font-size: 0.76rem;
    line-height: 1.45;
  }
  .tlist code {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--mx-soft);
  }

  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 760px) {
    .cv__hint {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .tlist li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }
</style>

<script>
  /**
   * Progressive enhancement only. The diagram is already on the page; this
   * turns it into a pannable board and enables click-to-query plus
   * highlighting of a table with its relationships.
   */
  import { createBoard, type Insets } from '../../lib/board';

  const root = document.querySelector<HTMLElement>('[data-erd-root]');
  const viewport = root?.querySelector<HTMLElement>('[data-board]');
  const world = root?.querySelector<HTMLElement>('[data-world]');
  const canvas = root?.querySelector<HTMLElement>('[data-canvas]');

  if (root && viewport && world && canvas) {
    // The inline bootstrap above already added `js`; this clears the hold once
    // the board has been fitted.
    root.classList.add('js');

    /* -- Pan / zoom ------------------------------------------------ */

    const chrome = root.querySelector<HTMLElement>('[data-controls]');

    const gutter = 16;
    const navHeight = () => document.querySelector<HTMLElement>('header.nav')?.offsetHeight ?? 60;
    const deckHeight = () => document.querySelector<HTMLElement>('[data-console]')?.offsetHeight ?? 90;

    /** Everything a focused table must stay clear of, measured fresh. */
    function insets(): Insets {
      const copy = document.querySelector<HTMLElement>('[data-screen-chrome]');
      return {
        top: navHeight() + (copy?.offsetHeight ?? 0) + gutter,
        right: gutter,
        bottom: deckHeight() + (chrome?.offsetHeight ?? 0) + gutter,
        left: gutter,
      };
    }

    /** Fitting only dodges the bars; the overlays float over the canvas. */
    function fitInsets(): Insets {
      return {
        top: navHeight() + 10,
        right: gutter,
        bottom: deckHeight() + 10,
        left: gutter,
      };
    }

    const board = createBoard({
      viewport,
      world,
      content: canvas,
      insets,
      fitInsets,
      gridStep: 22,
    });

    root.querySelector('[data-zoom-in]')?.addEventListener('click', () => board.zoomBy(1.25));
    root.querySelector('[data-zoom-out]')?.addEventListener('click', () => board.zoomBy(1 / 1.25));
    root.querySelector('[data-fit]')?.addEventListener('click', () => board.fit());

    // Start fitted, so a visitor sees the whole schema rather than a corner.
    board.fit();
    root.classList.remove('is-booting');

    /* -- Highlighting and click-to-query --------------------------- */

    const nodes = Array.from(canvas.querySelectorAll<HTMLElement>('.tnode'));
    const edges = Array.from(canvas.querySelectorAll<SVGGElement>('.edge'));

    function clear() {
      canvas!.classList.remove('has-hot');
      for (const node of nodes) node.classList.remove('is-hot', 'is-near');
      for (const edge of edges) edge.classList.remove('is-hot');
    }

    function highlight(table: string) {
      clear();
      canvas!.classList.add('has-hot');
      const related = new Set<string>();
      for (const edge of edges) {
        const a = edge.dataset.a;
        const b = edge.dataset.b;
        if (a === table || b === table) {
          edge.classList.add('is-hot');
          if (a) related.add(a);
          if (b) related.add(b);
        }
      }
      for (const node of nodes) {
        const name = node.dataset.table ?? '';
        if (name === table) node.classList.add('is-hot');
        else if (related.has(name)) node.classList.add('is-near');
      }
    }

    for (const node of nodes) {
      const name = node.dataset.table ?? '';
      const head = node.querySelector<HTMLButtonElement>('button[data-query]');
      if (head) head.disabled = false;

      node.addEventListener('pointerenter', () => highlight(name));
      node.addEventListener('pointerleave', clear);
      node.addEventListener('focusout', clear);

      node.addEventListener('focusin', () => {
        highlight(name);
        // A keyboard visitor must never be left focusing something off-screen.
        board.reveal(node);
      });

      head?.addEventListener('click', () => {
        // Clicking a table runs it; the command bar owns execution.
        document.dispatchEvent(new CustomEvent('db:run', { detail: head.dataset.query ?? '' }));
      });
    }

    viewport.addEventListener('pointerleave', clear);
  }
</script>
