---
/**
 * The ER diagram: every table as a node, every foreign key as a bezier edge
 * landing on the exact column rows it joins. It fills the screen — this is the
 * main event of the landing page.
 *
 * Fully server-rendered from `schema` and `relations`, so it is there with
 * JavaScript switched off. JavaScript only adds the extras: click-to-query and
 * hover/focus highlighting of a table and its relationships.
 *
 * Everything technical carries translate="no": browser auto-translation turns
 * `PK` into `PAQUETE` and table names into prose, which would wreck the point.
 */
import { buildDiagram } from '../../lib/diagram';
import { useT } from '../../i18n/utils';
import type { Locale } from '../../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useT(locale);
const diagram = buildDiagram(locale === 'es' ? 'es' : 'en');
---

<section class="pane" data-erd-root>
  <header class="pane__head">
    <h2 class="pane__title" id="erd-title">{t('db.schemaTitle')}</h2>
    <p class="pane__hint mono">{t('db.clickTable')}</p>

    <details class="tlist">
      <summary class="mono">
        {diagram.tableCount} {t('db.tables')} · {diagram.columnCount} {t('db.columns')}
      </summary>
      <ul>
        {
          diagram.nodes
            .slice()
            .sort((a, b) => a.table.localeCompare(b.table))
            .map((node) => (
              <li>
                <code translate="no">{node.table}</code>
                <span class="muted">{node.comment}</span>
              </li>
            ))
        }
      </ul>
    </details>
  </header>

  <div class="erd" role="group" aria-labelledby="erd-title" tabindex="0" translate="no">
    <div class="erd__canvas" style={`width:${diagram.width}px;height:${diagram.height}px`}>
      <svg
        class="erd__edges"
        width={diagram.width}
        height={diagram.height}
        viewBox={`0 0 ${diagram.width} ${diagram.height}`}
        aria-hidden="true"
        focusable="false"
      >
        {
          diagram.edges.map((edge) => (
            <g class="edge" data-a={edge.from} data-b={edge.to}>
              <title>{edge.label}</title>
              <path d={edge.d} />
              <circle class="edge__end" cx={edge.x1} cy={edge.y1} r="2.6" />
              <circle class="edge__end edge__end--pk" cx={edge.x2} cy={edge.y2} r="3.4" />
            </g>
          ))
        }
      </svg>

      {
        diagram.nodes.map((node) => (
          <article
            class="tnode"
            data-table={node.table}
            style={`left:${node.x}px;top:${node.y}px;width:${node.w}px`}
          >
            <button
              class="tnode__head mono"
              type="button"
              data-query={`SELECT * FROM ${node.table};`}
              title={node.comment}
              disabled
            >
              <span class="tnode__dot" aria-hidden="true" />
              <span class="tnode__name">{node.table}</span>
              <span class="tnode__count">{node.rows.length}</span>
            </button>
            <ul class="tnode__cols">
              {node.rows.map((row) => (
                <li class:list={['crow', { 'is-pk': row.pk, 'is-fk': !!row.fk }]}>
                  <span class="crow__name">{row.name}</span>
                  <span class="crow__type">{row.type + (row.nullable ? '?' : '')}</span>
                  {row.pk && <span class="chip chip--pk">PK</span>}
                  {row.fk && (
                    <span class="chip chip--fk">
                      FK<span class="vh"> {'→'} {row.fk}</span>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .pane {
    position: relative;
    min-width: 0;
    min-height: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .pane__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1rem;
  }
  .pane__title {
    font-size: 0.82rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0;
  }
  .pane__hint {
    margin: 0;
    font-size: 0.72rem;
    color: var(--mx);
  }

  /* ── Scroll viewport ──────────────────────────────────────────── */
  .erd {
    flex: 1 1 auto;
    min-height: 260px;
    overflow: auto;
    overscroll-behavior: contain;
    border: 1px solid var(--line-dim);
    border-radius: var(--radius);
    background-color: var(--bg-sunken);
    background-image: radial-gradient(var(--grid) 1px, transparent 1px);
    background-size: 22px 22px;
    scrollbar-width: thin;
    scrollbar-color: var(--mx-deep) transparent;
  }
  .erd::-webkit-scrollbar {
    width: 10px;
    height: 10px;
  }
  .erd::-webkit-scrollbar-thumb {
    background: var(--mx-deep);
    border-radius: 10px;
  }
  .erd__canvas {
    position: relative;
    flex: none;
  }
  .erd__edges {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  /* ── Edges ────────────────────────────────────────────────────── */
  .edge path {
    fill: none;
    stroke: var(--line-hi);
    stroke-width: 1.2;
    transition: stroke 0.18s ease, stroke-width 0.18s ease, opacity 0.18s ease;
  }
  .edge__end {
    fill: var(--bg-sunken);
    stroke: var(--line-hi);
    stroke-width: 1.2;
  }
  .edge__end--pk {
    fill: var(--mx-deep);
  }
  .has-hot .edge:not(.is-hot) path,
  .has-hot .edge:not(.is-hot) circle {
    opacity: 0.18;
  }
  .edge.is-hot path {
    stroke: var(--mx);
    stroke-width: 1.9;
  }
  .edge.is-hot circle {
    stroke: var(--mx);
  }

  /* ── Table nodes ──────────────────────────────────────────────── */
  .tnode {
    position: absolute;
    z-index: 2;
    background: var(--bg-card);
    border: 1px solid var(--line-dim);
    border-radius: 5px;
    overflow: hidden;
    font-family: var(--font-mono);
    transition: border-color 0.18s ease, box-shadow 0.18s ease, opacity 0.18s ease;
  }
  .has-hot .tnode:not(.is-hot):not(.is-near) {
    opacity: 0.45;
  }
  .tnode.is-near {
    border-color: var(--line-hi);
  }
  .tnode.is-hot {
    border-color: var(--mx);
    box-shadow:
      0 0 0 1px rgba(45, 212, 191, 0.35),
      0 14px 34px -18px #000;
  }

  .tnode__head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 6px;
    width: 100%;
    height: 30px;
    padding: 0 8px;
    border: 0;
    border-bottom: 1px solid var(--line-dim);
    background: var(--bg-elev);
    color: var(--text-hi);
    font-family: inherit;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-align: left;
    cursor: pointer;
  }
  .tnode__head[disabled] {
    cursor: default;
  }
  .tnode__head:hover:not([disabled]) {
    background: rgba(45, 212, 191, 0.12);
    color: var(--mx-soft);
  }
  .tnode__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--mx);
    box-shadow: 0 0 0 2px rgba(45, 212, 191, 0.16);
  }
  .tnode__name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tnode__count {
    font-size: 9px;
    font-weight: 400;
    color: var(--muted);
  }

  .tnode__cols {
    list-style: none;
    margin: 0;
    padding: 0 0 8px;
  }
  .crow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto auto;
    align-items: center;
    gap: 5px;
    height: 21px;
    padding: 0 8px;
    font-size: 10.5px;
    line-height: 21px;
    color: var(--text);
  }
  .crow + .crow {
    border-top: 1px solid rgba(127, 138, 163, 0.07);
  }
  .crow.is-pk .crow__name {
    color: var(--text-hi);
  }
  .crow__name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .crow__type {
    font-size: 9.5px;
    color: var(--muted);
  }
  .chip {
    font-size: 8.5px;
    line-height: 13px;
    padding: 0 3px;
    border-radius: 3px;
    border: 1px solid;
    letter-spacing: 0.04em;
  }
  .chip--pk {
    color: var(--violet);
    border-color: rgba(167, 139, 250, 0.42);
  }
  .chip--fk {
    color: var(--amber);
    border-color: rgba(251, 191, 36, 0.34);
  }

  /* ── Table list: a dropdown, so it never steals screen height ─── */
  .tlist {
    margin-left: auto;
    position: relative;
  }
  .tlist summary {
    cursor: pointer;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
  .tlist summary:hover {
    color: var(--mx);
  }
  .tlist ul {
    position: absolute;
    right: 0;
    top: calc(100% + 0.4rem);
    z-index: 20;
    width: min(30rem, 86vw);
    max-height: 60vh;
    overflow: auto;
    list-style: none;
    margin: 0;
    padding: 0.7rem 0.85rem;
    display: grid;
    gap: 0.3rem;
    background: var(--bg-elev);
    border: 1px solid var(--line-hi);
    border-radius: var(--radius);
    box-shadow: 0 24px 50px -24px #000;
  }
  .tlist li {
    display: grid;
    grid-template-columns: 10.5rem minmax(0, 1fr);
    gap: 0.6rem;
    font-size: 0.76rem;
    line-height: 1.45;
  }
  .tlist code {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--mx-soft);
  }

  .vh {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 560px) {
    .tlist li {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }
</style>

<script>
  /**
   * Progressive enhancement only. The diagram is already on the page; this
   * enables click-to-query and highlights a table with its relationships.
   */
  const root = document.querySelector<HTMLElement>('[data-erd-root]');
  const canvas = root?.querySelector<HTMLElement>('.erd__canvas');

  if (root && canvas) {
    const nodes = Array.from(canvas.querySelectorAll<HTMLElement>('.tnode'));
    const edges = Array.from(canvas.querySelectorAll<SVGGElement>('.edge'));

    function clear() {
      canvas!.classList.remove('has-hot');
      for (const node of nodes) node.classList.remove('is-hot', 'is-near');
      for (const edge of edges) edge.classList.remove('is-hot');
    }

    function highlight(table: string) {
      clear();
      canvas!.classList.add('has-hot');
      const related = new Set<string>();
      for (const edge of edges) {
        const a = edge.dataset.a;
        const b = edge.dataset.b;
        if (a === table || b === table) {
          edge.classList.add('is-hot');
          if (a) related.add(a);
          if (b) related.add(b);
        }
      }
      for (const node of nodes) {
        const name = node.dataset.table ?? '';
        if (name === table) node.classList.add('is-hot');
        else if (related.has(name)) node.classList.add('is-near');
      }
    }

    for (const node of nodes) {
      const name = node.dataset.table ?? '';
      const head = node.querySelector<HTMLButtonElement>('button[data-query]');
      if (head) head.disabled = false;

      node.addEventListener('pointerenter', () => highlight(name));
      node.addEventListener('focusin', () => highlight(name));
      node.addEventListener('pointerleave', clear);
      node.addEventListener('focusout', clear);

      head?.addEventListener('click', () => {
        // Clicking a table runs it; the command bar owns execution.
        document.dispatchEvent(new CustomEvent('db:run', { detail: head.dataset.query ?? '' }));
      });
    }

    canvas.addEventListener('pointerleave', clear);
  }
</script>
